---
import Logo from "./Logo.astro";
import { PORTAL_URL, OPTIMANTRA } from "../config";

const links = [
  { href: "/services", label: "What we treat" },
  { href: "/how-it-works", label: "How it works" },
  { href: "/pricing", label: "Pricing" },
  { href: "/doctor", label: "Your clinicians" },
  { href: "/about", label: "About" },
];
const current = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 border-b border-pine-900/[0.06] bg-cream/85 backdrop-blur-xl">
  <div class="mx-auto flex h-[4.25rem] max-w-6xl items-center justify-between px-6">
    <a href="/" aria-label="SheWellRX home" class="transition-opacity hover:opacity-80">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "relative rounded-full px-3.5 py-2 text-[0.875rem] font-medium transition-colors duration-300 hover:bg-pine-900/[0.05] hover:text-pine-900",
              current.startsWith(link.href) ? "text-pine-900 after:absolute after:bottom-0.5 after:left-1/2 after:h-1 after:w-1 after:-translate-x-1/2 after:rounded-full after:bg-apricot-500" : "text-ink/70",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={OPTIMANTRA.portalLoginUrl} rel="noopener" class="text-sm font-medium text-ink/60 transition-colors hover:text-pine-900">Patient portal</a>
      <a href={PORTAL_URL} class="btn-accent group !px-5 !py-2.5">
        Schedule a video visit
        <svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </a>
    </div>

    <button
      id="menu-toggle"
      class="rounded-full p-2.5 transition-colors hover:bg-pine-900/5 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6 text-pine-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <!-- Full screen menu on small screens -->
  <div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col bg-pine-900 text-cream lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="flex h-[4.25rem] items-center justify-between px-6">
      <Logo tone="light" />
      <button id="menu-close" class="rounded-full p-2.5 transition-colors hover:bg-white/10" aria-label="Close menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <nav class="flex flex-1 flex-col justify-center gap-1 px-8" aria-label="Mobile">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class="menu-link font-display text-4xl font-medium leading-tight tracking-tight text-cream/90 transition-colors hover:text-apricot-300"
            style={`transition-delay:${i * 40}ms`}
          >
            {link.label}
          </a>
        ))
      }
      <a href={OPTIMANTRA.portalLoginUrl} rel="noopener" class="menu-link mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-cream/60">Patient portal</a>
    </nav>
    <div class="px-8 pb-10">
      <a href={PORTAL_URL} class="btn-accent w-full !py-4 !text-base">Schedule a video visit</a>
      <p class="mt-4 text-center text-xs text-cream/50">If you are experiencing a medical emergency, call 911.</p>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    toggle.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) closeBtn?.focus();
  };
  toggle?.addEventListener("click", () => setOpen(true));
  closeBtn?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
