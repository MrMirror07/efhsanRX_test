---
interface Props {
  rating?: number;
  class?: string;
}
const { rating = 5, class: className = "h-4 w-4" } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

<span class="inline-flex items-center gap-0.5" aria-label={`${rating} out of 5 stars`}>
  {
    stars.map((s) => (
      <svg
        viewBox="0 0 20 20"
        class:list={[className, s <= Math.round(rating) ? "fill-gold" : "fill-pine-900/15"]}
        aria-hidden="true"
      >
        <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
      </svg>
    ))
  }
</span>
