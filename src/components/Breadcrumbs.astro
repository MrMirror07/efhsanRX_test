---
import { SITE } from "../config";
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [{ name: "Home", href: "/" }, ...items].map((it, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: it.name,
    item: new URL(it.href, SITE.url).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="text-xs text-ink/50">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="transition-colors hover:text-pine-900">Home</a></li>
    {
      items.map((it, i) => (
        <li class="flex items-center gap-1.5">
          <span aria-hidden="true">/</span>
          {i === items.length - 1 ? <span aria-current="page" class="text-ink/70">{it.name}</span> : <a href={it.href} class="transition-colors hover:text-pine-900">{it.name}</a>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
