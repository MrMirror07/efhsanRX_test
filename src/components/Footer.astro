---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="bg-pine-900 text-cream/80">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="[&_span]:!text-cream [&_.text-apricot-500]:!text-apricot-300">
          <Logo />
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed">
          Expert virtual care, personalized treatment plans, and ongoing support
          from licensed clinicians — wherever you are.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-cream">Care</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="/services" class="hover:text-cream">What we treat</a></li>
          <li><a href="/how-it-works" class="hover:text-cream">How it works</a></li>
          <li><a href="/book" class="hover:text-cream">Book a visit</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-cream">Company</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="/about" class="hover:text-cream">About us</a></li>
          <li><a href="/book" class="hover:text-cream">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-cream/15 pt-8 text-xs leading-relaxed text-cream/60">
      <p>
        EfhsanRX does not provide emergency services. If you are experiencing a
        medical emergency, call 911 or go to the nearest emergency room.
        Treatment plans and prescriptions are issued only when a licensed
        clinician determines they are appropriate.
      </p>
      <p class="mt-4">&copy; {year} EfhsanRX. All rights reserved.</p>
    </div>
  </div>
</footer>
