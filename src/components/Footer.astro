---
import Logo from "./Logo.astro";
import { SITE, DOCTOR, PRACTICE, PORTAL_URL, OPTIMANTRA } from "../config";
import { CONDITIONS } from "../data/conditions";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-pine-900 text-cream/80">
  <div class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-pine-700/40 blur-3xl" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo tone="light" />
        <p class="mt-8 max-w-sm font-display text-3xl leading-tight text-cream">
          Care that <em class="text-apricot-300">listens</em> until it finds the answer.
        </p>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-cream/60">
          Virtual women's health from a board certified ObGyn. One flat fee, no insurance needed, for patients across New Jersey.
        </p>
        <a href={PORTAL_URL} class="btn-accent mt-8">Start your visit</a>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 md:col-span-7">
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/50">Conditions</h3>
          <ul class="mt-5 space-y-3 text-sm">
            {CONDITIONS.map((c) => <li><a href={`/conditions/${c.slug}/`} class="transition-colors hover:text-cream">{c.name}</a></li>)}
            <li><a href="/online-gynecologist-new-jersey/" class="transition-colors hover:text-cream">Online gynecologist in NJ</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/50">Care</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li><a href="/services" class="transition-colors hover:text-cream">What we treat</a></li>
            <li><a href="/how-it-works" class="transition-colors hover:text-cream">How it works</a></li>
            <li><a href="/pricing" class="transition-colors hover:text-cream">Pricing</a></li>
            <li><a href={PORTAL_URL} class="transition-colors hover:text-cream">Book a visit</a></li>
            <li><a href={OPTIMANTRA.portalLoginUrl} rel="noopener" class="transition-colors hover:text-cream">Patient portal sign in</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/50">Practice</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li><a href="/doctor" class="transition-colors hover:text-cream">Your doctor</a></li>
            <li><a href="/about" class="transition-colors hover:text-cream">About us</a></li>
            <li><a href={PRACTICE.googleMapsUrl} rel="noopener" target="_blank" class="transition-colors hover:text-cream">Google reviews</a></li>
            <li><a href={`mailto:${SITE.email}`} class="transition-colors hover:text-cream">{SITE.email}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/50">Your rights</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li><a href="/good-faith-estimate" class="transition-colors hover:text-cream">Good Faith Estimate</a></li>
            <li><a href="/notice-of-privacy-practices" class="transition-colors hover:text-cream">Notice of Privacy Practices</a></li>
            <li><a href="/telehealth-consent" class="transition-colors hover:text-cream">Telehealth consent</a></li>
            <li><a href="/privacy" class="transition-colors hover:text-cream">Privacy policy</a></li>
            <li><a href="/terms" class="transition-colors hover:text-cream">Terms of service</a></li>
            <li><a href="/accessibility" class="transition-colors hover:text-cream">Accessibility</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 grid gap-6 border-t border-cream/10 pt-8 text-xs leading-relaxed text-cream/50 md:grid-cols-2">
      <p>
        SheWellRX does not provide emergency services. If you are experiencing a medical emergency, call 911 or go to the nearest emergency room. Treatment plans and prescriptions are issued only when a licensed clinician determines they are appropriate. Video visits are for patients physically located in New Jersey at the time of the visit.
      </p>
      <p>
        Care is provided by {DOCTOR.name}, a physician licensed in New Jersey and board certified in obstetrics and gynecology by the American Board of Obstetrics and Gynecology. {SITE.name} is the telehealth practice of {DOCTOR.practice}. Self pay patients have the right to a Good Faith Estimate of charges. Booking a visit means you accept our Terms of Service, Telehealth Consent and Terms of Care, and Privacy Policy.
        <span class="mt-3 block">&copy; {year} {SITE.name}. All rights reserved.</span>
      </p>
    </div>
  </div>
</footer>
