---
/**
 * Scroll driven brand film, canvas edition. The film ships as 96 webp frames
 * painted onto a canvas, so scrubbing costs one image draw per frame instead
 * of a video decoder seek. This is the technique big product pages use for
 * flawless scroll scrubbing. Copy phases in over the film and hands off to
 * the classic page. Reduced motion visitors get the final frame, held still.
 */
import { PORTAL_URL } from "../config";
---

<section id="film" class="relative bg-pine-900" data-no-reveal>
  <div id="film-track" class="h-[320vh]">
    <div class="sticky top-0 flex h-screen items-center justify-center overflow-hidden">
      <canvas id="film-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-pine-900/75 via-pine-900/10 to-pine-900/40"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
        <p data-phase="0" class="film-phase font-display text-3xl leading-tight text-cream sm:text-5xl">
          Somewhere between exhaustion and "I'm fine."
        </p>
        <p data-phase="1" class="film-phase absolute inset-x-6 top-1/2 -translate-y-1/2 font-display text-3xl leading-tight text-cream opacity-0 sm:text-5xl">
          There is a name for what you are feeling.
        </p>
        <div data-phase="2" class="film-phase absolute inset-x-6 top-1/2 -translate-y-1/2 opacity-0">
          <p class="font-display text-3xl leading-tight text-cream sm:text-5xl">
            And there is a doctor who will find it.
          </p>
          <a href={PORTAL_URL} id="film-cta" class="btn-accent pointer-events-none mt-8 !px-8 !py-4 !text-base">
            Book a visit
          </a>
        </div>
      </div>

      <p
        id="film-hint"
        class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-xs font-medium uppercase tracking-[0.25em] text-cream/60"
      >
        Keep scrolling
      </p>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("film");
  const track = document.getElementById("film-track");
  const canvas = document.getElementById("film-canvas") as HTMLCanvasElement | null;
  if (section && track && canvas) {
    const ctx = canvas.getContext("2d");
    const phases = section.querySelectorAll<HTMLElement>("[data-phase]");
    const cta = document.getElementById("film-cta");
    const hint = document.getElementById("film-hint");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const FRAME_COUNT = 96;
    const frames: (HTMLImageElement | null)[] = new Array(FRAME_COUNT).fill(null);
    const frameSrc = (i: number) => `/film-frames/f${String(i).padStart(3, "0")}.webp`;

    let drawn = -1;
    const sizeCanvas = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      drawn = -1; // force a repaint at the new size
    };

    const draw = (index: number) => {
      if (!ctx) return;
      // Fall back to the nearest loaded frame so fast scrolling during the
      // initial load never flashes an empty canvas.
      let img: HTMLImageElement | null = null;
      for (let d = 0; d < FRAME_COUNT; d++) {
        const lo = index - d;
        const hi = index + d;
        if (lo >= 0 && frames[lo]) { img = frames[lo]; index = lo; break; }
        if (hi < FRAME_COUNT && frames[hi]) { img = frames[hi]; index = hi; break; }
      }
      if (!img || index === drawn) return;
      drawn = index;
      const cw = canvas.width;
      const ch = canvas.height;
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    };

    const load = (i: number, onload?: () => void) => {
      const img = new Image();
      img.decoding = "async";
      img.src = frameSrc(i);
      img.onload = () => {
        frames[i] = img;
        onload?.();
      };
    };

    sizeCanvas();
    window.addEventListener("resize", () => {
      sizeCanvas();
      draw(drawn < 0 ? 0 : drawn);
    });

    if (reduced) {
      track.classList.remove("h-[320vh]");
      track.classList.add("h-screen");
      phases.forEach((p) => (p.style.opacity = p.dataset.phase === "2" ? "1" : "0"));
      cta?.classList.remove("pointer-events-none");
      hint?.remove();
      load(FRAME_COUNT - 1, () => draw(FRAME_COUNT - 1));
    } else {
      // First frame first for instant paint, then the rest in order.
      load(0, () => draw(0));
      for (let i = 1; i < FRAME_COUNT; i++) load(i);

      let target = 0;
      let current = 0;

      const opacityFor = (progress: number, index: number) => {
        const start = index / 3;
        const end = (index + 1) / 3;
        const fade = 0.07;
        if (progress < start - fade || progress > end + fade) return 0;
        if (progress < start + fade) return (progress - (start - fade)) / (2 * fade);
        if (progress > end - fade && index < 2) return ((end + fade) - progress) / (2 * fade);
        return 1;
      };

      const onScroll = () => {
        const rect = track.getBoundingClientRect();
        const total = track.offsetHeight - window.innerHeight;
        const progress = Math.min(1, Math.max(0, -rect.top / total));
        target = progress;
        phases.forEach((p, i) => {
          p.style.opacity = String(opacityFor(progress, i));
        });
        if (cta) cta.classList.toggle("pointer-events-none", progress < 0.75);
        if (hint) hint.style.opacity = progress > 0.05 ? "0" : "1";
      };

      const tick = () => {
        current += (target - current) * 0.22;
        draw(Math.round(current * (FRAME_COUNT - 1)));
        requestAnimationFrame(tick);
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .film-phase {
    transition: opacity 0.15s linear;
    text-wrap: balance;
  }
  #film-hint {
    transition: opacity 0.4s ease;
  }
</style>
