---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { CONDITIONS } from "../../data/conditions";
import { SITE, DOCTOR, PRICING, REVIEWS } from "../../config";
import drCopur from "../../assets/dr-copur.jpg";
import imgMenopause from "../../assets/tile-menopause.png";
import imgHormone from "../../assets/tile-hormone.png";
import imgBirthControl from "../../assets/tile-birth-control.png";
import imgPeriods from "../../assets/calm-tea.png";
import imgIntimacy from "../../assets/tile-intimacy.png";
import imgLabs from "../../assets/tile-labs.png";

export function getStaticPaths() {
  return CONDITIONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const images = { menopause: imgMenopause, hormone: imgHormone, "birth-control": imgBirthControl, periods: imgPeriods, intimacy: imgIntimacy, labs: imgLabs } as const;
const img = images[c.img];
const related = c.related
  .map((slug) => CONDITIONS.find((x) => x.slug === slug) ?? (slug === "online-gynecologist-new-jersey" ? { slug, name: "Online gynecologist in New Jersey", href: "/online-gynecologist-new-jersey/" } : null))
  .filter(Boolean) as { slug: string; name: string; href?: string }[];
const bookHref = `/book?concern=${c.concern}`;
const reviewedDate = new Date(c.reviewed + "T12:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": `${SITE.url}/conditions/${c.slug}/#page`,
      url: `${SITE.url}/conditions/${c.slug}/`,
      name: c.title,
      description: c.description,
      inLanguage: "en-US",
      lastReviewed: c.reviewed,
      reviewedBy: { "@type": "Physician", name: DOCTOR.name, medicalSpecialty: "Gynecologic", url: `${SITE.url}/doctor` },
      about: { "@type": "MedicalCondition", name: c.medicalCondition },
      specialty: "Gynecologic",
      audience: { "@type": "MedicalAudience", audienceType: "Patient", geographicArea: { "@type": "State", name: "New Jersey" } },
      publisher: { "@type": "MedicalClinic", name: SITE.name, url: SITE.url },
    },
    {
      "@type": "FAQPage",
      mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={c.title} description={c.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[36rem] bg-[radial-gradient(55%_50%_at_85%_0%,rgba(60,111,127,0.14),transparent_70%)]" aria-hidden="true"></div>
    <div class="section relative grid items-center gap-12 !pb-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <Breadcrumbs items={[{ name: "What we treat", href: "/services" }, { name: c.name, href: `/conditions/${c.slug}/` }]} />
        <p class="eyebrow mt-8">{c.eyebrow}</p>
        <h1 class="display mt-4 text-4xl leading-[1.05] sm:text-5xl lg:text-[3.5rem]">{c.h1}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">{c.intro}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={bookHref} class="btn-accent group !px-7 !py-4 !text-base">
            Start your visit · ${PRICING.initial.price}
            <svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
          <span class="text-sm text-ink/60">Video visits for patients in New Jersey · No insurance needed</span>
        </div>
      </div>
      <figure class="overflow-hidden rounded-[2rem] lg:col-span-5" data-reveal>
        <Image src={img} alt={`${c.name} care at SheWellRX`} class="aspect-[4/3] w-full object-cover" widths={[640, 960]} sizes="(min-width: 1024px) 40vw, 92vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="section grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Is this you?</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Symptoms we hear every day</h2>
        <p class="mt-4 text-ink/70">Tap the ones that sound familiar. Nothing is stored; it simply helps you decide whether a visit is the right next step.</p>
      </div>
      <ul class="flex flex-wrap gap-2.5 lg:col-span-7" data-reveal-stagger>
        {
          c.symptoms.map((s) => (
            <li>
              <button type="button" class="symptom-chip rounded-full border border-pine-900/15 bg-cream px-4 py-2.5 text-sm font-medium text-pine-900 transition-all duration-300 hover:border-pine-500 hover:bg-white aria-pressed:border-apricot-500 aria-pressed:bg-apricot-50 aria-pressed:text-apricot-800" aria-pressed="false">{s}</button>
            </li>
          ))
        }
        <li class="basis-full pt-3">
          <p id="symptom-note" class="hidden rounded-2xl bg-pine-50 px-5 py-4 text-sm text-pine-900">Sounds like a visit is worth it. <a href={bookHref} class="font-semibold underline underline-offset-4">Start your visit</a> and Dr. Copur reads your full story before you connect.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="bg-sand/60">
    <div class="section">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">What a video visit does</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">How {DOCTOR.shortName} treats {c.name.toLowerCase()} by video</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2" data-reveal-stagger>
        {
          c.whatWeDo.map((w, i) => (
            <article class="card !p-8" data-spotlight>
              <p class="font-display text-3xl leading-none text-apricot-500">0{i + 1}</p>
              <h3 class="mt-4 font-display text-2xl font-medium text-pine-900">{w.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-ink/70">{w.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="section grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">By video</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">What can be prescribed or ordered</h2>
        <ul class="mt-6 space-y-3">
          {c.prescribe.map((p) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink/75">
              <svg class="mt-1 h-4 w-4 shrink-0 text-apricot-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
              {p}
            </li>
          ))}
        </ul>
        <p class="mt-5 text-xs text-ink/50">Examples of what can be prescribed when clinically appropriate. Every decision is made by your clinician, with you, during your visit. No prescription is issued from a questionnaire alone.</p>
      </div>
      <div data-reveal>
        <p class="eyebrow">In person, and we will say so</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">When a camera is not enough</h2>
        <ul class="mt-6 space-y-3">
          {c.inPerson.map((p) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink/75">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-pine-400" aria-hidden="true"></span>
              {p}
            </li>
          ))}
        </ul>
        <p class="mt-5 rounded-2xl border border-pine-900/10 bg-cream p-4 text-sm text-ink/70">For emergencies, call 911. If Dr. Copur decides during your visit that telehealth is not right for your concern, your visit fee is refunded.</p>
      </div>
    </div>
  </section>

  <section class="bg-pine-900 text-cream">
    <div class="section grid items-center gap-10 !py-16 lg:grid-cols-12">
      <div class="lg:col-span-8" data-reveal>
        <p class="eyebrow !text-apricot-300">Simple pricing</p>
        <h2 class="display mt-3 text-3xl !text-cream sm:text-4xl">${PRICING.initial.price} initial visit · ${PRICING.followUp.price} follow up</h2>
        <p class="mt-4 max-w-2xl text-cream/70">Thirty minute video visits, a written plan, prescriptions and lab orders when appropriate, and two weeks of messaging. Paid once at booking, nothing billed later. HSA and FSA accepted. Self pay patients receive a <a href="/good-faith-estimate" class="underline underline-offset-4 hover:text-cream">Good Faith Estimate</a>.</p>
      </div>
      <div class="lg:col-span-4 lg:text-right" data-reveal>
        <a href={bookHref} class="btn-accent !px-8 !py-4 !text-base">Book this visit</a>
      </div>
    </div>
  </section>

  <section>
    <div class="section max-w-3xl" data-reveal>
      <p class="eyebrow">Questions</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl">{c.name}: asked and answered</h2>
      <div class="mt-8 divide-y divide-pine-900/10">
        {
          c.faq.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl font-medium text-pine-900">
                {f.q}
                <span class="faq-plus inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-pine-900/15 text-pine-700">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="section grid gap-10 lg:grid-cols-12">
      <div class="flex gap-5 rounded-[1.75rem] border border-pine-900/[0.08] bg-cream p-6 lg:col-span-7" data-reveal>
        <Image src={drCopur} alt={DOCTOR.name} width={160} height={160} class="h-20 w-20 shrink-0 rounded-2xl object-cover object-top" />
        <div class="text-sm leading-relaxed text-ink/70">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-pine-500">Medically reviewed</p>
          <p class="mt-1 font-semibold text-pine-900">{DOCTOR.name}, FACOG</p>
          <p>Board certified in obstetrics and gynecology by the American Board of Obstetrics and Gynecology since {DOCTOR.boardCertifiedSince}. Licensed in New Jersey. {REVIEWS.google.rating} stars across {REVIEWS.google.count} Google reviews. Reviewed {reviewedDate}. <a href="/doctor" class="font-medium text-apricot-700 underline underline-offset-4">About Dr. Copur</a></p>
        </div>
      </div>
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Related care</p>
        <ul class="mt-4 space-y-2">
          {related.map((r) => (
            <li>
              <a href={r.href ?? `/conditions/${r.slug}/`} class="group flex items-center justify-between rounded-2xl border border-pine-900/10 bg-cream px-4 py-3 text-sm font-medium text-pine-900 transition-all hover:border-pine-500 hover:bg-white">
                {r.name}
                <svg class="h-4 w-4 text-pine-400 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" /></svg>
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="group flex items-center justify-between rounded-2xl border border-pine-900/10 bg-cream px-4 py-3 text-sm font-medium text-pine-900 transition-all hover:border-pine-500 hover:bg-white">Everything we treat
              <svg class="h-4 w-4 text-pine-400 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" /></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Symptom chips: purely client side, nothing stored. Once two or more are
  // selected, a gentle nudge appears.
  const chips = document.querySelectorAll<HTMLButtonElement>(".symptom-chip");
  const note = document.getElementById("symptom-note");
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      chip.setAttribute("aria-pressed", String(chip.getAttribute("aria-pressed") !== "true"));
      const n = document.querySelectorAll('.symptom-chip[aria-pressed="true"]').length;
      note?.classList.toggle("hidden", n < 2);
    }),
  );
</script>
