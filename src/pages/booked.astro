---
import Layout from "../layouts/Layout.astro";
import { SITE, OPTIMANTRA } from "../config";

/**
 * Landing page after a completed booking in the OptiMantra portal. Set as
 * the confirmation page URL inside OptiMantra's online booking settings.
 * Kept out of search results; only booked patients ever arrive here.
 */
const next = [
  {
    title: "Complete two short forms before your visit",
    body: "Your confirmation email contains two links: the telehealth consent to sign and your intake questionnaire. Together they take about ten minutes, and your clinician reviews every answer before the visit begins. Both also appear in the patient portal under Forms.",
  },
  {
    title: "Set up your patient portal",
    body: "Choose New Sign Up with the same email, first name, and date of birth you used to book. Your receipt, Good Faith Estimate, messages, and results live there.",
  },
  {
    title: "Join from a private place",
    body: "Your video link is in the same email and in your reminders. Choose a quiet, private space in New Jersey and keep your medication list nearby.",
  },
];
---

<Layout
  title="Your Visit Is Booked | SheWellRX"
  description="Your SheWellRX video visit is booked. Here is what happens next."
  noindex
>
  <section class="section">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Confirmed</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">Your video visit is booked.</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        Thank you for scheduling your visit. The next steps are simple, and each
        one is explained below.
      </p>
      <div id="booked-details" class="mx-auto mt-6 hidden max-w-md rounded-2xl border border-pine-900/10 bg-white p-5 text-left text-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-pine-500">Your visit</p>
        <p class="mt-2 font-display text-lg text-pine-900" id="booked-service"></p>
        <p class="mt-1 text-ink/70" id="booked-when"></p>
        <p class="mt-1 text-ink/70" id="booked-with"></p>
        <p class="mt-3 text-xs text-ink/50">Times are shown in Eastern Time. A confirmation with your receipt has been sent to your email.</p>
      </div>
      <div class="mx-auto mt-6 max-w-md rounded-2xl border border-apricot-200 bg-apricot-50 p-5 text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-apricot-700">Before your visit</p>
        <p class="mt-2 text-sm leading-relaxed text-ink/80">Please sign your telehealth consent and complete your intake questionnaire. The links are in your confirmation email and in the patient portal, and together they take about ten minutes.</p>
        <a href={OPTIMANTRA.portalLoginUrl} rel="noopener" class="btn-primary mt-4 w-full !py-3 !text-sm">Open the patient portal</a>
      </div>
    </div>
    <ol class="mx-auto mt-12 grid max-w-3xl gap-4">
      {
        next.map((s, i) => (
          <li class="card flex gap-5 !p-6 sm:!p-8">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-pine-800 font-display text-lg text-cream">
              {i + 1}
            </span>
            <div>
              <h2 class="font-display text-xl font-medium text-pine-900">{s.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mx-auto mt-10 max-w-2xl text-center text-sm leading-relaxed text-ink/60">
      To change your time, use the link in your confirmation email,
      <a href={OPTIMANTRA.portalLoginUrl} rel="noopener" class="font-medium text-apricot-700 underline underline-offset-4">sign in to the patient portal</a>, or write
      to <a href={`mailto:${SITE.email}`} class="font-medium text-apricot-700 underline underline-offset-4">{SITE.email}</a>.
      For emergencies, call 911.
    </p>
  </section>
</Layout>

<script>
  // OptiMantra appends the booked service, clinician, date, and time to the
  // confirmation page URL. Show them once, then strip the query so nothing
  // personal lingers in the address bar or browser history. Nothing is stored.
  const q = new URLSearchParams(location.search);
  const service = q.get("serviceName");
  const date = q.get("apptDate");
  const time = q.get("apptTime");
  const pract = q.get("practName");
  const box = document.getElementById("booked-details");
  if (box && (service || date)) {
    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };
    if (service) set("booked-service", service);
    if (date || time) set("booked-when", [date, time].filter(Boolean).join(" at "));
    if (pract) set("booked-with", `With ${pract}`);
    box.classList.remove("hidden");
  }
  if (location.search) history.replaceState(null, "", location.pathname);
</script>
