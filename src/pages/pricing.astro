---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { SITE, PRICING, PORTAL_URL, DOCTOR } from "../config";
import calmTea from "../assets/calm-tea.png";

const included = [PRICING.initial, PRICING.followUp];

const comparisons = [
  { label: "Average in-person new patient gynecology visit, self-pay", price: "about $256" },
  { label: "Self-pay price at leading virtual menopause clinics", price: "$250 to $350" },
  { label: "SheWellRX initial visit with a board certified ObGyn", price: `$${PRICING.initial.price}`, highlight: true },
];

const faqs = [
  {
    q: "When am I charged?",
    a: "At the end of scheduling, after you have chosen your visit and time, you pay securely in the patient portal. That payment reserves your time with your clinician, and nothing is billed afterward. You may cancel or reschedule up to twenty four hours before your visit for a full refund; the full terms are in the Telehealth Consent and Terms of Care you sign before your first visit.",
  },
  {
    q: "Can I use my HSA or FSA?",
    a: "Yes. A telehealth visit for medical care is a qualified medical expense, and HSA and FSA cards are accepted directly at checkout.",
  },
  {
    q: "What is not included?",
    a: "Lab work is billed by the laboratory and medications by your pharmacy, at their usual self-pay or insurance prices. Tests are ordered only when they would change your care plan, and you are told before anything is ordered.",
  },
  {
    q: "Can I get money back from my insurance?",
    a: "If your plan includes out-of-network benefits, a superbill is available on request. A superbill is an itemized receipt you submit to your insurer for possible reimbursement. Many PPO plans reimburse a portion of the visit fee; the amount depends on your plan.",
  },
  {
    q: "Why is SheWellRX a self-pay practice?",
    a: "SheWellRX is a self-pay practice and does not bill insurance. Visits billed through insurance are often limited to a few minutes and priced after the fact. A flat fee allows a thirty minute, unhurried visit and a price you know before you schedule, with no bill arriving afterward. A superbill is available on request if your plan includes out-of-network benefits.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title={`Transparent Telehealth Pricing | ${SITE.name}`}
  description={`SheWellRX pricing is transparent: $${PRICING.initial.price} initial video visit, $${PRICING.followUp.price} follow-up visit, paid once at scheduling. Self-pay, no membership, HSA and FSA accepted.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">Pricing</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        One visit, one price, known before you schedule.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        SheWellRX is a self-pay practice with transparent pricing. You see the
        full price of your visit here, before you schedule, and it does not
        change. We do not bill insurance, there is no membership, and a
        superbill is available on request for out-of-network benefits.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <div class="grid gap-6 md:grid-cols-2">
        {
          included.map((tier) => (
            <div class="card flex flex-col">
              <h2 class="font-display text-xl font-medium text-pine-900">{tier.label}</h2>
              <p class="mt-3">
                <span class="font-display text-6xl text-pine-900">${tier.price}</span>
                <span class="ml-2 inline-block text-sm text-ink/60">one payment · {tier.duration}</span>
              </p>
              <ul class="mt-6 flex-1 space-y-3">
                {tier.includes.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-pine-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
              <a href={PORTAL_URL} class="btn-primary mt-8 w-full">Schedule this visit</a>
            </div>
          ))
        }
      </div>

      <div class="mt-8 grid gap-4 rounded-3xl border border-pine-900/10 bg-cream p-8 sm:grid-cols-3">
        <div>
          <h3 class="font-semibold text-pine-900">HSA and FSA accepted</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">
            Pay with your health savings or flexible spending card.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-pine-900">Paid when you schedule</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">
            One secure payment reserves your time with your clinician. Nothing is billed afterward.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-pine-900">Superbill on request</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">
            If your plan includes out-of-network benefits, an itemized receipt is available for you to submit to your insurer.
          </p>
        </div>
      </div>

      <div class="mt-6 rounded-3xl border border-pine-900/10 bg-white p-6 text-sm leading-relaxed text-ink/70">
        <p class="font-semibold text-pine-900">Your right to a Good Faith Estimate</p>
        <p class="mt-2">
          SheWellRX does not participate in any health plan network, so we are out of network for every insurer, and we do not bill Medicare or Medicaid. Under the federal No Surprises Act, every self-pay patient receives a written Good Faith Estimate of expected charges when she schedules a visit, or on request at any time. The amount we will bill for any service is always available on request.
          <a href="/good-faith-estimate" class="font-medium text-apricot-700 underline underline-offset-4">Read the Good Faith Estimate notice</a>.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="section grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Pricing in context</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">
          A specialist visit at a price you can plan for.
        </h2>
        <p class="mt-4 leading-relaxed text-ink/70">
          A self-pay new patient gynecology visit in person averages about the
          same as our flat fee, and virtual menopause clinics charge as much or
          more, often for a shorter visit with a nurse practitioner. Your visit
          at SheWellRX is a thirty minute video visit with a board certified
          ObGyn, and there is no membership.
        </p>
        <ul class="mt-8 space-y-3">
          {
            comparisons.map((c) => (
              <li
                class:list={[
                  "flex items-center justify-between gap-4 rounded-2xl px-5 py-4",
                  c.highlight
                    ? "bg-pine-800 text-cream"
                    : "border border-pine-900/10 bg-white text-ink/70",
                ]}
              >
                <span class="text-sm leading-snug">{c.label}</span>
                <span
                  class:list={[
                    "font-display text-xl whitespace-nowrap",
                    c.highlight ? "text-apricot-300" : "text-pine-900",
                  ]}
                >
                  {c.price}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-ink/50">
          Market figures from published self-pay price data, August 2026.
          Sources are listed in our research notes.
        </p>
      </div>
      <figure class="overflow-hidden rounded-[2.5rem]">
        <Image
          src={calmTea}
          alt="A woman holding a warm cup of tea in soft morning light"
          class="h-full w-full object-cover"
          widths={[480, 768, 1080]}
          sizes="(min-width: 1024px) 45vw, 90vw"
        />
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="section max-w-3xl">
      <p class="eyebrow">Pricing questions</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl">Questions about pricing, answered.</h2>
      <div class="mt-10 divide-y divide-pine-900/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-pine-900">
                {f.q}
                <span class="text-pine-400 transition-transform group-open:rotate-45">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <a href={PORTAL_URL} class="btn-primary !px-8 !py-4 !text-base">Schedule a video visit</a>
      </div>
    </div>
  </section>
</Layout>
