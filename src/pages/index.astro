      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="pb-16 sm:pb-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="relative overflow-hidden rounded-[2.5rem]">
        <Image
          src={vitalityOutdoors}
          alt="A vibrant woman walking outdoors in golden evening light"
          class="h-[26rem] w-full object-cover"
          widths={[768, 1080, 1600]}
          sizes="(min-width: 1152px) 1104px, 92vw"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-pine-900/85 via-pine-900/35 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-8 text-center sm:p-14">
          <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
            Feel like yourself again.
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-cream/80">
            Book a video visit and get answers this week.
          </p>
          <a href={PORTAL_URL} class="btn-accent mt-6 !px-8 !py-4 !text-base">Book a visit</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Care matcher: a three question, client side only quiz. Answers live in
  // this closure and nowhere else; nothing is stored or transmitted. Its job
  // is to show the visitor a personalized picture of her care.
  const root = document.getElementById("fit-check");
  if (root) {
    const steps = root.querySelectorAll<HTMLElement>("[data-step]");
    const segs = root.querySelectorAll<HTMLElement>(".fit-seg");
    const label = document.getElementById("fit-label");
    const qnum = document.getElementById("fit-qnum");
    const back = document.getElementById("fit-back");
    const restart = document.getElementById("fit-restart");
    const questionNumber: Record<string, number> = { "1": 1, "2": 2, "3": 3 };

    let current = "1";
    let concern = "else";
    const history: string[] = [];

    const render = () => {
      const n = questionNumber[current];
      steps.forEach((el) => {
        const on = el.dataset.step === current;
        el.classList.toggle("hidden", !on);
        if (on) {
          el.classList.remove("fit-in");
          void el.offsetWidth;
          el.classList.add("fit-in");
        }
      });
      if (label && qnum) {
        if (n) {
          label.innerHTML = `Question <span id="fit-qnum">${n}</span> of 3`;
        } else {
          label.textContent = "Your match";
        }
      }
      segs.forEach((seg, i) => {
        const filled = n === undefined || i < n;
        seg.classList.toggle("bg-pine-800", filled);
        seg.classList.toggle("bg-pine-900/10", !filled);
      });
      if (back) back.style.display = history.length ? "" : "none";
      if (restart) restart.style.display = n === undefined ? "" : "none";
    };

    const go = (next: string) => {
      history.push(current);
      current = next;
      render();
    };

    root.querySelectorAll<HTMLButtonElement>("button[data-answer]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const answer = btn.dataset.answer;
        const value = btn.dataset.value ?? "";
        if (answer === "concern") {
          concern = value;
          go("2");
        } else if (answer === "pregnant") {
          go(value === "yes" ? "result-pregnant" : "3");
        } else if (answer === "nj") {
          go(value === "yes" ? `result-${concern}` : "result-nj");
        }
      });
    });
    back?.addEventListener("click", () => {
      const prev = history.pop();
      if (prev) {
        current = prev;
        render();
      }
    });
    restart?.addEventListener("click", () => {
      history.length = 0;
      current = "1";
      render();
    });
  }
</script>
