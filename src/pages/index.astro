---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Stars from "../components/Stars.astro";
import FilmScroll from "../components/FilmScroll.astro";
import { SITE, DOCTOR, DOCTOR2, PRACTICE, PRICING, PORTAL_URL, BOOKING_BY_CONCERN, REVIEWS, TREATMENTS } from "../config";
import heroEditorial from "../assets/hero-editorial.jpg";
import visitWindow from "../assets/visit-window.jpg";
import drCopur from "../assets/dr-copur.jpg";
import nurefsan from "../assets/nurefsan-copur.jpg";
import calmTea from "../assets/calm-tea.png";
import tileBirthControl from "../assets/tile-birth-control.png";
import tileMenopause from "../assets/tile-menopause.png";
import tileHormone from "../assets/tile-hormone.png";
import tileIntimacy from "../assets/tile-intimacy.png";
import tileLabs from "../assets/tile-labs.png";
import portraitHijab from "../assets/portrait-hijab.jpg";
import portraitBlack from "../assets/portrait-black.jpg";
import portraitAsian from "../assets/portrait-asian.jpg";
import portraitSouthAsian from "../assets/portrait-southasian.jpg";

const tileHref: Record<string, string> = {
  menopause: "/conditions/menopause-treatment-new-jersey/",
  "hormone-therapy": "/conditions/hormone-therapy-new-jersey/",
  "birth-control": "/conditions/birth-control-online-new-jersey/",
  "sexual-health": "/conditions/vaginal-dryness-painful-sex-new-jersey/",
  periods: "/conditions/pcos-irregular-periods-new-jersey/",
  labs: "/services#labs",
};

const tileImages = {
  "birth-control": tileBirthControl,
  menopause: tileMenopause,
  "hormone-therapy": tileHormone,
  "sexual-health": tileIntimacy,
  periods: calmTea,
  labs: tileLabs,
} as const;

/** Concern picker. Each option deep links into the guided start on /book. Nothing is stored. */
const concerns = [
  { key: "menopause", label: "Menopause or perimenopause symptoms", img: "menopause" },
  { key: "hormone-therapy", label: "Hormone therapy: begin, adjust, or a second opinion", img: "hormone-therapy" },
  { key: "birth-control", label: "Birth control", img: "birth-control" },
  { key: "intimacy", label: "Vaginal dryness, pain with intimacy, or low desire", img: "sexual-health" },
  { key: "periods", label: "Periods: heavy, painful, or irregular, and PCOS", img: "periods" },
  { key: "labs", label: "Labs, screenings, or a hormone check", img: "labs" },
  { key: "else", label: "Something else in women's health", img: "labs" },
] as const;

const marquee = [
  "Perimenopause", "Menopause", "Hormone therapy", "Birth control", "PCOS", "Heavy periods",
  "Hot flashes", "Sleep", "Vaginal dryness", "Intimate health", "Hormone panels", "Thyroid checks",
];

const steps = [
  {
    n: "01",
    title: "Tell us what you are experiencing",
    body: "Two minutes on this site: your concern, what you want from the visit, and a short safety check. Nothing you answer is stored. Then you see the full price, pick a time, and pay securely.",
  },
  {
    n: "02",
    title: "Meet your clinician on video",
    body: "An unhurried conversation with a clinician who has already reviewed your history. No waiting room, and no need to explain yourself twice.",
  },
  {
    n: "03",
    title: "Leave with a care plan",
    body: "A written care plan you can return to, prescriptions sent to your pharmacy when appropriate, and two weeks of secure messaging included with every visit.",
  },
];

const faqs = [
  {
    q: "How much does a visit cost?",
    a: `$${PRICING.initial.price} for your initial visit and $${PRICING.followUp.price} for follow-up visits. One payment per visit, nothing recurring, no membership, and no unexpected bills. HSA and FSA cards are accepted.`,
  },
  {
    q: "Do you take insurance?",
    a: "SheWellRX is a self-pay practice and does not bill insurance. This allows longer visits at one transparent price, with no paperwork for you. If you have out of network benefits, we can provide a superbill to submit to your plan.",
  },
  {
    q: "Who will I see?",
    a: `A small care team. ${DOCTOR.name} is board certified in obstetrics and gynecology by the American Board of Obstetrics and Gynecology since ${DOCTOR.boardCertifiedSince}, with more than thirty five years of experience in women's health and ${REVIEWS.google.rating} stars across ${REVIEWS.google.count} Google reviews. ${DOCTOR2.name}, a doctorally prepared certified nurse midwife, joins the practice soon. You will always be told who your visit is with, and you may request the physician for any visit.`,
  },
  {
    q: "Is my information private?",
    a: "Yes. Your health information lives in a secure, HIPAA compliant patient portal, separate from this website. The short questions on this site run only in your browser and are never stored or sent anywhere. Your medical history is collected inside the portal after you book, and we share your records only with the team treating you.",
  },
  {
    q: "What if I need in person care?",
    a: "SheWellRX is a fully virtual practice, and a video visit does not replace an examination when one is needed. When your concern requires an in-person evaluation, imaging, or a procedure, we tell you clearly, refer you to the appropriate specialist near you, and make sure your records follow you.",
  },
];

/** Google's "G" mark, used only to attribute reviews to Google as its display terms require. */
const googleG =
  '<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.2v3.1C3.2 21.3 7.3 24 12 24z"/><path fill="#FBBC05" d="M5.3 14.3c-.2-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3V6.6H1.2C.4 8.2 0 10 0 12s.4 3.8 1.2 5.4l4.1-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C18 1.2 15.2 0 12 0 7.3 0 3.2 2.7 1.2 6.6l4.1 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="relative overflow-hidden" data-hero>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[42rem] bg-[radial-gradient(60%_50%_at_80%_10%,rgba(60,111,127,0.16),transparent_70%),radial-gradient(40%_40%_at_10%_90%,rgba(223,111,150,0.12),transparent_70%)]" aria-hidden="true"></div>
    <div class="section relative grid items-center gap-14 !py-14 lg:grid-cols-12 lg:gap-10 sm:!py-20">
      <div class="lg:col-span-6">
        <p class="eyebrow" data-hero-line>Women's telehealth · New Jersey</p>
        <h1 class="display mt-5 text-[2.75rem] leading-[1.02] sm:text-6xl lg:text-[4.25rem]">
          <span class="block" data-hero-line>Women's health care,</span>
          <span class="block" data-hero-line>by video, that</span>
          <span class="block" data-hero-line><em>listens</em> to you.</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink/70" data-hero-fade>
          Perimenopause and menopause, contraception, cycle concerns, and intimate health,
          cared for in a thirty minute video visit with a board certified ObGyn. You leave
          with a written care plan. One transparent fee of ${PRICING.initial.price}, with no insurance required.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4" data-hero-fade>
          <a href={PORTAL_URL} class="btn-accent group !px-7 !py-4 !text-base">
            Start your visit
            <svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
          <a href="/how-it-works" class="btn-secondary !py-4 !text-base">See how it works</a>
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-ink/70" data-hero-fade>
          <a href={PRACTICE.googleMapsUrl} rel="noopener" target="_blank" class="inline-flex items-center gap-2 transition-colors hover:text-pine-900">
            <Stars rating={REVIEWS.google.rating} />
            <span><strong class="font-semibold text-pine-900" data-google-rating>{REVIEWS.google.rating}</strong> from <span data-google-count>{REVIEWS.google.count}</span> Google reviews</span>
          </a>
          <span class="hidden h-4 w-px bg-pine-900/15 sm:block" aria-hidden="true"></span>
          <span>Board certified ObGyn (ABOG) since {DOCTOR.boardCertifiedSince}</span>
        </div>
      </div>

      <div class="relative lg:col-span-6" data-hero-media>
        <div class="overflow-hidden rounded-[2.5rem] shadow-[0_40px_80px_-40px_rgba(15,39,51,0.45)]">
          <Image
            src={heroEditorial}
            alt="A woman at home by a sunlit window, smiling during a video visit on her tablet"
            class="aspect-[4/5] w-full object-cover sm:aspect-[5/4] lg:aspect-[4/5]"
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 46vw, 92vw"
            loading="eager"
          />
        </div>
        <div class="absolute -left-4 bottom-8 flex items-center gap-3 rounded-2xl bg-white/95 p-3 pr-5 shadow-[0_24px_50px_-24px_rgba(15,39,51,0.5)] backdrop-blur sm:left-6" data-hero-float>
          <div class="flex -space-x-3">
            <Image src={drCopur} alt="" width={96} height={96} class="h-12 w-12 rounded-full border-2 border-white object-cover object-top" />
            <Image src={nurefsan} alt="" width={96} height={96} class="h-12 w-12 rounded-full border-2 border-white object-cover object-top" />
          </div>
          <div class="text-sm leading-tight">
            <p class="font-semibold text-pine-900">Your care team</p>
            <p class="mt-0.5 text-xs text-ink/60">A board certified ObGyn, with a certified nurse midwife joining soon</p>
          </div>
        </div>
        <div class="absolute right-4 top-5 sm:right-6" data-hero-float>
          <span class="chip"><span class="chip-dot"></span> Now scheduling video visits</span>
        </div>
      </div>
    </div>

    <!-- Conditions marquee -->
    <div class="relative border-y border-pine-900/[0.06] bg-white/60 py-4" data-hero-fade>
      <div class="marquee" aria-hidden="true">
        {
          [0, 1].map(() => (
            <div class="marquee-track">
              {marquee.map((m) => (
                <span class="flex items-center gap-10 whitespace-nowrap font-display text-lg text-pine-900/80">
                  {m}
                  <span class="h-1.5 w-1.5 rounded-full bg-apricot-400" />
                </span>
              ))}
            </div>
          ))
        }
      </div>
      <p class="sr-only">We treat {marquee.join(", ")}.</p>
    </div>
  </section>

  <!-- Scroll driven brand film -->
  <FilmScroll />

  <!-- Treatment tiles -->
  <section class="bg-white">
    <div class="section">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow">What we treat</p>
          <h2 class="display mt-4 text-4xl sm:text-5xl">Care for what you are <em>experiencing.</em></h2>
          <p class="mt-5 text-lg leading-relaxed text-ink/70">
            From contraception to menopausal hormone therapy, treatment is prescribed during your visit and sent to your pharmacy when clinically appropriate.
          </p>
        </div>
        <a href="/services" class="btn-secondary">All conditions we treat</a>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          TREATMENTS.map((t) => (
            <a href={tileHref[t.slug] ?? `/services#${t.slug}`} class="group tile">
              <div class="tile-img">
                <Image
                  src={tileImages[t.slug]}
                  alt={`${t.title} at SheWellRX`}
                  widths={[480, 768]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                />
              </div>
              <div class="flex items-start justify-between gap-4 p-6">
                <div>
                  <h3 class="font-display text-2xl font-medium text-pine-900">{t.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink/70">{t.blurb}</p>
                  <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-pine-500">{t.examples.join(" · ")}</p>
                </div>
                <span class="arrow-chip mt-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="mt-6 text-xs text-ink/50">
        Medications are examples of what can be prescribed when clinically appropriate. Every prescription decision is made by your clinician during your visit.
      </p>
    </div>
  </section>

  <!-- Numbers -->
  <section class="bg-pine-900 text-cream">
    <div class="section grid gap-10 !py-16 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      <div>
        <p class="font-display text-6xl leading-none text-cream"><span data-count={REVIEWS.google.rating} data-decimals="1">{REVIEWS.google.rating}</span></p>
        <p class="mt-3 text-sm text-cream/60">Google rating across <span data-google-count>{REVIEWS.google.count}</span> verified reviews</p>
      </div>
      <div>
        <p class="font-display text-6xl leading-none text-cream"><span data-count="35" data-suffix="+">35+</span></p>
        <p class="mt-3 text-sm text-cream/60">Years of experience in women's health, board certified since {DOCTOR.boardCertifiedSince}</p>
      </div>
      <div>
        <p class="font-display text-6xl leading-none text-cream"><span data-count="30">30</span><span class="text-3xl text-cream/60"> min</span></p>
        <p class="mt-3 text-sm text-cream/60">Every video visit, unhurried</p>
      </div>
      <div>
        <p class="font-display text-6xl leading-none text-cream">$<span data-count={PRICING.initial.price}>{PRICING.initial.price}</span></p>
        <p class="mt-3 text-sm text-cream/60">One transparent fee, paid once, nothing billed later</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section>
    <div class="section grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2 class="display mt-4 text-4xl sm:text-5xl">Scheduled in minutes. <em>Seen</em> within days.</h2>
        <div class="relative mt-10 overflow-hidden rounded-[2rem]">
          <Image
            src={visitWindow}
            alt="A woman by a window smiling at her tablet during a video visit"
            class="aspect-[4/3] w-full object-cover"
            widths={[640, 960]}
            sizes="(min-width: 1024px) 40vw, 92vw"
          />
        </div>
      </div>
      <ol class="relative grid gap-4 lg:col-span-7" data-reveal-stagger>
        {
          steps.map((s) => (
            <li class="card relative flex gap-6 !p-7 sm:!p-8" data-spotlight>
              <span class="font-display text-3xl leading-none text-apricot-500">{s.n}</span>
              <div>
                <h3 class="font-display text-2xl font-medium text-pine-900">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.body}</p>
              </div>
            </li>
          ))
        }
        <li class="pl-1 pt-2">
          <a href="/how-it-works" class="text-sm font-semibold text-pine-700 underline underline-offset-4 transition-colors hover:text-apricot-600">See the full process</a>
        </li>
      </ol>
    </div>
  </section>

  <!-- Concern picker: routes into the guided start on /book -->
  <section class="bg-sand/70">
    <div class="section grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">Your care, matched</p>
        <h2 class="display mt-4 text-4xl sm:text-5xl">Tell us what you are experiencing. We will show you <em>the plan.</em></h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink/70">
          Choose your concern, answer a few brief questions, and see how SheWellRX would approach your care, with the full price, before you pay anything.
        </p>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-ink/50">
          Nothing you select is stored or sent anywhere. Every visit happens on video, for patients in New Jersey.
        </p>
      </div>

      <div class="rounded-[2rem] bg-white p-6 shadow-[0_30px_70px_-40px_rgba(15,39,51,0.45)] sm:p-8" data-reveal>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-pine-500">Step 1 of 3 · Your concern</p>
        <p class="mt-3 font-display text-2xl text-pine-900">What brings you here today?</p>
        <div class="mt-5 grid gap-2">
          {
            concerns.map((c) => (
              <a
                href={BOOKING_BY_CONCERN[c.key] ?? PORTAL_URL}
                class="group flex items-center gap-4 rounded-2xl border border-pine-900/10 bg-cream p-2.5 pr-4 text-left transition-all duration-300 hover:-translate-y-0.5 hover:border-pine-500/60 hover:bg-white hover:shadow-md"
              >
                <Image src={tileImages[c.img]} alt="" widths={[96, 192]} sizes="48px" class="h-12 w-12 shrink-0 rounded-xl object-cover" />
                <span class="flex-1 text-sm font-medium leading-snug">{c.label}</span>
                <svg class="h-4 w-4 shrink-0 text-pine-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-apricot-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" /></svg>
              </a>
            ))
          }
        </div>
        <p class="mt-4 text-xs text-ink/50">Next: a two minute safety check, then your price and time.</p>
      </div>
    </div>
  </section>

  <!-- The care team -->
  <section class="bg-white">
    <div class="section grid items-center gap-14 lg:grid-cols-12">
      <figure class="relative mx-auto w-full max-w-sm lg:col-span-5" data-reveal>
        <div class="aspect-[4/5] overflow-hidden rounded-[2.5rem] bg-sand">
          <Image
            src={drCopur}
            alt={`${DOCTOR.name}, board certified obstetrician gynecologist`}
            class="h-full w-full object-cover object-top"
            widths={[480, 600]}
            sizes="(min-width: 1024px) 24rem, 90vw"
          />
        </div>
        <figcaption class="absolute -bottom-5 left-6 right-6 rounded-2xl bg-pine-900 px-5 py-4 text-cream shadow-xl">
          <p class="font-display text-lg leading-snug">"Your symptoms are real, and they are treatable."</p>
          <p class="mt-1 text-xs text-cream/60">The principle every visit begins from</p>
        </figcaption>
      </figure>
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">Your care team</p>
        <h2 class="display mt-4 text-4xl sm:text-5xl">A small team that <em>knows</em> your history.</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/70">
          Your care comes from a small team rather than a rotating roster. {DOCTOR.name} is board certified in obstetrics and gynecology by the American Board of Obstetrics and Gynecology, with more than thirty five years of experience in women's health. {DOCTOR2.name}, a doctorally prepared certified nurse midwife, joins the practice soon. At each follow-up visit, your history is already known, and you may always request the physician.
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal-stagger>
          <li class="flex gap-4 rounded-[1.5rem] bg-cream p-5">
            <Image src={drCopur} alt="" width={112} height={112} class="h-14 w-14 shrink-0 rounded-2xl object-cover object-top" />
            <div class="text-sm leading-relaxed">
              <p class="font-semibold text-pine-900">{DOCTOR.name}</p>
              <p class="text-xs text-ink/60">Physician · Board certified ObGyn (ABOG) since {DOCTOR.boardCertifiedSince}</p>
              <p class="mt-2 text-ink/70">Perimenopause and menopause, hormone therapy, and complex cycle concerns.</p>
            </div>
          </li>
          <li class="flex gap-4 rounded-[1.5rem] bg-cream p-5">
            <Image src={nurefsan} alt="" width={112} height={112} class="h-14 w-14 shrink-0 rounded-2xl object-cover object-top" />
            <div class="text-sm leading-relaxed">
              <p class="font-semibold text-pine-900">{DOCTOR2.name}</p>
              <p class="text-xs text-ink/60">Certified Nurse Midwife (not a physician) · Joining soon</p>
              <p class="mt-2 text-ink/70">{DOCTOR2.focus.join(", ").replace(/, ([^,]*)$/, ", and $1")}.</p>
            </div>
          </li>
        </ul>
        <a href="/doctor" class="btn-primary group mt-9">
          Meet the care team
          <svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Every woman -->
  <section class="bg-white">
    <div class="section">
      <div class="grid items-end gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7" data-reveal>
          <p class="eyebrow">For every woman in New Jersey</p>
          <h2 class="display mt-4 text-4xl sm:text-5xl">Your story, <em>heard</em> in your own words.</h2>
        </div>
        <p class="text-lg leading-relaxed text-ink/70 lg:col-span-5" data-reveal>
          Women in their twenties choosing contraception, women in their fifties seeking relief from hot flashes, and every stage between. Private, unhurried, and respectful of your culture, your faith, and your choices. Interpreters are arranged on request.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4" data-reveal-stagger>
        {
          [
            { img: portraitHijab, alt: "A woman wearing a hijab smiling at her phone during a video visit", label: "Periods and PCOS" },
            { img: portraitBlack, alt: "A woman at her kitchen table smiling during a video visit on her laptop", label: "Hormone therapy" },
            { img: portraitAsian, alt: "A woman on a sofa holding a tablet during a video visit", label: "Birth control" },
            { img: portraitSouthAsian, alt: "A woman by a window holding a phone during a video visit", label: "Menopause" },
          ].map((p, i) => (
            <figure class:list={["group relative overflow-hidden rounded-[1.75rem] bg-sand", i % 2 === 1 && "lg:translate-y-8"]}>
              <Image src={p.img} alt={p.alt} class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" widths={[480, 720]} sizes="(min-width: 1024px) 24vw, 45vw" />
              <figcaption class="absolute bottom-3 left-3 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-pine-900 backdrop-blur">{p.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing preview -->
  <section class="bg-sand/70">
    <div class="section">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Simple pricing</p>
        <h2 class="display mt-4 text-4xl sm:text-5xl">One visit. One price. <em>Nothing hidden.</em></h2>
        <p class="mt-5 text-lg leading-relaxed text-ink/70">
          You will always know the full cost before you schedule. We do not bill insurance, there is no membership, and nothing is billed later.
        </p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2" data-reveal-stagger>
        {
          [PRICING.initial, PRICING.followUp].map((tier, i) => (
            <div class="card relative flex flex-col !p-9" data-spotlight>
              {i === 0 && <span class="absolute right-6 top-6 rounded-full bg-apricot-100 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-apricot-700">Most patients start here</span>}
              <h3 class="font-display text-2xl font-medium text-pine-900">{tier.label}</h3>
              <p class="mt-4">
                <span class="font-display text-6xl leading-none text-pine-900">${tier.price}</span>
                <span class="ml-2 inline-block text-sm text-ink/60">one time · {tier.duration}</span>
              </p>
              <ul class="mt-7 flex-1 space-y-3">
                {tier.includes.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-apricot-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                    {item}
                  </li>
                ))}
              </ul>
              <a href={i === 0 ? PORTAL_URL : `${PORTAL_URL}?type=followup`} class={`${i === 0 ? "btn-accent" : "btn-primary"} mt-9 w-full`}>Schedule this visit</a>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-ink/60">
        HSA and FSA accepted. Labs and medications are billed separately by your lab and pharmacy. <a href="/pricing" class="font-medium text-apricot-700 underline underline-offset-4">Full pricing details</a> and your <a href="/good-faith-estimate" class="font-medium text-apricot-700 underline underline-offset-4">Good Faith Estimate</a>.
      </p>
    </div>
  </section>

  <!-- Reviews: rendered from the verified snapshot at build time, then refreshed from Google through /api/reviews once the Places API key is configured -->
  <section class="bg-white" id="reviews">
    <div class="section">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="min-w-0 lg:col-span-4" data-reveal>
          <div class="lg:sticky lg:top-28">
            <p class="eyebrow">Patient reviews</p>
            <h2 class="display mt-4 text-4xl sm:text-5xl">Rated <span data-google-rating>{REVIEWS.google.rating}</span> on Google by the women <em>in our care.</em></h2>
            <div class="mt-8 rounded-[1.75rem] border border-pine-900/[0.08] bg-cream p-6">
              <div class="flex items-center gap-5">
                <span class="font-display text-6xl leading-none text-pine-900" data-google-rating>{REVIEWS.google.rating}</span>
                <div>
                  <Stars rating={REVIEWS.google.rating} class="h-5 w-5" />
                  <p class="mt-1.5 text-sm text-ink/70"><span data-google-count>{REVIEWS.google.count}</span> reviews</p>
                </div>
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-2 text-xs text-ink/60">
                <Fragment set:html={googleG} />
                <span>Reviews from Google</span>
                <span id="reviews-status">· verified {REVIEWS.google.asOf}</span>
              </div>
              <a href={PRACTICE.googleMapsUrl} rel="noopener" target="_blank" class="btn-secondary mt-5 w-full">Read all reviews on Google</a>
            </div>
            <p class="mt-4 text-xs leading-relaxed text-ink/50" id="reviews-note">
              Reviews appear as written on the public Google listing of the practice. They describe individual experiences; results vary, and no outcome is guaranteed.
            </p>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-8" data-reveal>
          <div class="review-wall" id="review-wall" aria-label="Patient reviews" data-reviews={JSON.stringify(REVIEWS.quotes)}>
            {
              [0, 1].map((col) => (
                <div class="review-col" data-col={col}>
                  {[false, true].map((dup) =>
                    REVIEWS.quotes
                      .filter((_, i) => i % 2 === col)
                      .map((r) => (
                        <figure class="review-card" data-dup={dup ? "" : undefined} aria-hidden={dup ? "true" : undefined}>
                          <div class="flex items-center gap-3">
                            <span class="review-avatar" aria-hidden="true">{r.name.charAt(0).toUpperCase()}</span>
                            <div class="min-w-0 flex-1">
                              <p class="truncate text-sm font-semibold text-pine-900">{r.name}</p>
                              <p class="text-xs text-ink/50">{r.when}</p>
                            </div>
                            <Fragment set:html={googleG} />
                          </div>
                          <div class="mt-4"><Stars rating={5} /></div>
                          <blockquote class="mt-3 text-[15px] leading-relaxed text-ink/80">"{r.text}"</blockquote>
                        </figure>
                      )),
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="section max-w-3xl" data-reveal>
      <p class="eyebrow">Questions</p>
      <h2 class="display mt-4 text-4xl sm:text-5xl">Frequently <em>asked.</em></h2>
      <div class="mt-10 divide-y divide-pine-900/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl font-medium text-pine-900">
                {f.q}
                <span class="faq-plus inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-pine-900/15 text-pine-700">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="pb-20 sm:pb-28">
    <div class="mx-auto max-w-6xl px-6" data-reveal>
      <div class="relative overflow-hidden rounded-[2.5rem] bg-pine-900 px-8 py-16 text-center text-cream sm:px-14 sm:py-24">
        <div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-pine-600/40 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-32 -right-16 h-[28rem] w-[28rem] rounded-full bg-apricot-500/25 blur-3xl" aria-hidden="true"></div>
        <p class="eyebrow relative !text-apricot-300">Start today</p>
        <h2 class="display relative mx-auto mt-4 max-w-2xl text-4xl !text-cream sm:text-6xl">Feel like <em class="!text-apricot-300">yourself</em> again.</h2>
        <p class="relative mx-auto mt-5 max-w-xl text-cream/70">Begin today and choose a time that suits you. Two minutes to start, one transparent price, no insurance required.</p>
        <a href={PORTAL_URL} class="btn-accent relative mt-8 !px-8 !py-4 !text-base">Start your visit</a>
        <p class="relative mt-5 text-xs text-cream/50">Questions first? <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">{SITE.email}</a></p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* Cursor spotlight for cards marked data-spotlight */
  [data-spotlight] {
    --mx: 50%;
    --my: 50%;
  }
  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    [data-spotlight]::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: radial-gradient(240px circle at var(--mx) var(--my), rgba(223, 111, 150, 0.12), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    [data-spotlight]:hover::before {
      opacity: 1;
    }
  }

  /* Reviews wall: two slow columns on desktop, a swipe strip on phones, a static grid without JS or with reduced motion */
  .review-card {
    border-radius: 1.5rem;
    border: 1px solid rgba(15, 39, 51, 0.08);
    background: var(--color-cream);
    padding: 1.5rem;
  }
  .review-card[data-dup] {
    display: none;
  }
  .review-avatar {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    flex: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--color-pine-100);
    color: var(--color-pine-900);
    font-weight: 600;
  }
  .review-avatar img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .review-live {
    border-radius: 9999px;
    background: var(--color-apricot-50);
    color: var(--color-apricot-700);
    padding: 0.2rem 0.6rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 1023.98px) {
    .review-wall {
      display: flex;
      gap: 1rem;
      margin: 0 -1.5rem;
      overflow-x: auto;
      padding: 0.25rem 1.5rem 1rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .review-wall::-webkit-scrollbar {
      display: none;
    }
    .review-col {
      display: contents;
    }
    .review-card {
      flex: 0 0 min(84vw, 22rem);
      scroll-snap-align: start;
    }
  }
  @media (min-width: 1024px) {
    .review-wall {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      align-items: start;
    }
    .review-col {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .js .review-wall {
      height: 40rem;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    }
    .js .review-col {
      gap: 0;
      animation: review-up 56s linear infinite;
      will-change: transform;
    }
    .js .review-col > .review-card {
      margin-bottom: 1.25rem;
    }
    .js .review-col[data-col="1"] {
      animation-name: review-down;
      animation-duration: 64s;
    }
    .js .review-card[data-dup] {
      display: block;
    }
    .js .review-wall:hover .review-col,
    .js .review-wall:focus-within .review-col {
      animation-play-state: paused;
    }
  }
  @keyframes review-up {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }
  @keyframes review-down {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }
</style>

<script>
  // Reviews wall. The page ships with the verified snapshot already rendered.
  // When /api/reviews is configured (a Places API key in Cloudflare), the
  // reviews Google currently shows for the listing are placed first, the
  // rating and count update, and the status line says so. If the endpoint is
  // missing or fails, nothing changes. Review text is inserted as text, never
  // as HTML.
  type Review = { name: string; when: string; text: string; photo?: string; rating?: number; live?: boolean };
  const wall = document.getElementById("review-wall");
  const G =
    '<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.2v3.1C3.2 21.3 7.3 24 12 24z"/><path fill="#FBBC05" d="M5.3 14.3c-.2-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3V6.6H1.2C.4 8.2 0 10 0 12s.4 3.8 1.2 5.4l4.1-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C18 1.2 15.2 0 12 0 7.3 0 3.2 2.7 1.2 6.6l4.1 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>';
  const STAR = "M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z";
  const SVG = "http://www.w3.org/2000/svg";

  const stars = (n: number) => {
    const wrap = document.createElement("span");
    wrap.className = "inline-flex items-center gap-0.5";
    wrap.setAttribute("aria-label", `${n} out of 5 stars`);
    for (let i = 1; i <= 5; i++) {
      const svg = document.createElementNS(SVG, "svg");
      svg.setAttribute("viewBox", "0 0 20 20");
      svg.setAttribute("class", `h-4 w-4 ${i <= Math.round(n) ? "fill-gold" : "fill-pine-900/15"}`);
      svg.setAttribute("aria-hidden", "true");
      const path = document.createElementNS(SVG, "path");
      path.setAttribute("d", STAR);
      svg.append(path);
      wrap.append(svg);
    }
    return wrap;
  };

  const card = (r: Review, dup: boolean) => {
    const fig = document.createElement("figure");
    fig.className = "review-card";
    if (dup) {
      fig.setAttribute("data-dup", "");
      fig.setAttribute("aria-hidden", "true");
    }
    const head = document.createElement("div");
    head.className = "flex items-center gap-3";
    const avatar = document.createElement("span");
    avatar.className = "review-avatar";
    avatar.setAttribute("aria-hidden", "true");
    if (r.photo) {
      const img = document.createElement("img");
      img.src = r.photo;
      img.alt = "";
      img.loading = "lazy";
      img.referrerPolicy = "no-referrer";
      avatar.append(img);
    } else {
      avatar.textContent = (r.name || "G").charAt(0).toUpperCase();
    }
    const who = document.createElement("div");
    who.className = "min-w-0 flex-1";
    const name = document.createElement("p");
    name.className = "truncate text-sm font-semibold text-pine-900";
    name.textContent = r.name;
    const when = document.createElement("p");
    when.className = "text-xs text-ink/50";
    when.textContent = r.when;
    who.append(name, when);
    head.append(avatar, who);
    if (r.live) {
      const chip = document.createElement("span");
      chip.className = "review-live";
      chip.textContent = "Latest";
      head.append(chip);
    }
    head.insertAdjacentHTML("beforeend", G);
    const starWrap = document.createElement("div");
    starWrap.className = "mt-4";
    starWrap.append(stars(r.rating ?? 5));
    const quote = document.createElement("blockquote");
    quote.className = "mt-3 text-[15px] leading-relaxed text-ink/80";
    quote.textContent = `"${r.text}"`;
    fig.append(head, starWrap, quote);
    return fig;
  };

  const render = (list: Review[]) => {
    if (!wall) return;
    wall.replaceChildren();
    [0, 1].forEach((ci) => {
      const col = document.createElement("div");
      col.className = "review-col";
      col.dataset.col = String(ci);
      const items = list.filter((_, i) => i % 2 === ci);
      items.forEach((r) => col.append(card(r, false)));
      items.forEach((r) => col.append(card(r, true)));
      wall.append(col);
    });
  };

  if (wall) {
    const curated: Review[] = JSON.parse(wall.dataset.reviews || "[]");
    fetch("/api/reviews")
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((d) => {
        const raw: unknown[] = Array.isArray(d?.reviews) ? d.reviews : [];
        const live: Review[] = raw
          .filter((x): x is Record<string, unknown> => !!x && typeof x === "object" && typeof (x as any).text === "string" && typeof (x as any).rating === "number")
          .map((x) => ({
            name: String(x.author || "Google user"),
            when: String(x.when || ""),
            text: String(x.text),
            photo: typeof x.photo === "string" && x.photo.startsWith("https://") ? x.photo : undefined,
            rating: Number(x.rating),
            live: true,
          }));
        if (!live.length) return;
        const key = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 60);
        const seen = new Set(live.map((x) => key(x.text)));
        render([...live, ...curated.filter((c) => !seen.has(key(c.text)))]);
        const status = document.getElementById("reviews-status");
        if (status) status.textContent = "· updated automatically";
        const note = document.getElementById("reviews-note");
        if (note)
          note.textContent =
            "The latest reviews are shown as written on Google and refresh automatically; earlier reviews are quoted from the same public listing. They describe individual experiences; results vary, and no outcome is guaranteed.";
      })
      .catch(() => {});
  }
</script>
