---
import Layout from "../layouts/Layout.astro";

const conditions = [
  {
    title: "Weight management",
    body: "Medical weight care built around your metabolism, habits, and goals — with clinician-led follow-up, not one-size-fits-all plans.",
  },
  {
    title: "Hormonal health",
    body: "Evidence-based evaluation and treatment for hormone-related symptoms, from energy and sleep to mood and cycles.",
  },
  {
    title: "Hair & skin",
    body: "Dermatologist-informed treatment plans for hair loss, acne, and skin health, delivered discreetly to your door.",
  },
  {
    title: "Sexual health",
    body: "Judgment-free care and effective treatment options, handled with total privacy from consult to delivery.",
  },
  {
    title: "Everyday primary care",
    body: "Same-week virtual visits for common conditions, prescription renewals, and lab orders — without the waiting room.",
  },
  {
    title: "Mental wellness",
    body: "Support for stress, sleep, and mood with structured check-ins and care plans that adapt as you do.",
  },
];

const steps = [
  {
    n: "01",
    title: "Tell us about you",
    body: "Complete a short online health intake in about five minutes. Your answers help us match you with the right clinician.",
  },
  {
    n: "02",
    title: "Meet your clinician",
    body: "Connect by video or message with a licensed clinician who reviews your history and builds a plan that fits your life.",
  },
  {
    n: "03",
    title: "Start your plan",
    body: "If treatment is appropriate, prescriptions ship to your door or your local pharmacy — with ongoing check-ins included.",
  },
];

const faqs = [
  {
    q: "Is EfhsanRX right for me?",
    a: "EfhsanRX is designed for ongoing, non-emergency care. If you want expert guidance for conditions like weight, hormones, skin, or everyday health — without travel and waiting rooms — we're built for you. For emergencies, always call 911.",
  },
  {
    q: "Will I see a real, licensed clinician?",
    a: "Yes. Every visit is with a licensed clinician who reviews your full intake, meets with you, and is responsible for your treatment plan. Prescriptions are only issued when your clinician determines they're appropriate.",
  },
  {
    q: "How much does it cost?",
    a: "Pricing depends on your care program, and we'll always show you the full cost before you commit — no surprise bills. Many plans include visits, ongoing messaging, and follow-ups in one simple price.",
  },
  {
    q: "Is my information private?",
    a: "Your health information is handled confidentially and shared only with the care team treating you. Deliveries arrive in discreet packaging.",
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-32 right-[-10%] h-[28rem] w-[28rem] rounded-full bg-pine-100 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute bottom-[-20%] left-[-8%] h-96 w-96 rounded-full bg-apricot-100 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="section relative grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Virtual care clinic</p>
        <h1 class="display mt-4 text-4xl leading-[1.1] sm:text-5xl lg:text-6xl">
          Expert care that comes to you.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/70">
          EfhsanRX connects you with licensed clinicians for personalized
          treatment plans, prescriptions when appropriate, and follow-up that
          doesn't fall through the cracks — all from home.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/book" class="btn-accent">Book a visit</a>
          <a href="/how-it-works" class="btn-secondary">See how it works</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink/60">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-pine-500"></span>
            Licensed clinicians
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-pine-500"></span>
            Visits from home
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-pine-500"></span>
            Discreet delivery
          </li>
        </ul>
      </div>

      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="card !bg-pine-800 !p-10 text-cream">
          <p class="font-display text-2xl leading-snug">
            "Care shouldn't stop when the appointment ends."
          </p>
          <p class="mt-6 text-sm text-cream/70">
            Every EfhsanRX plan includes ongoing messaging with your care team,
            so questions get answered in hours — not at your next visit.
          </p>
          <div class="mt-8 grid grid-cols-3 gap-4 border-t border-cream/15 pt-8 text-center">
            <div>
              <p class="font-display text-2xl text-apricot-300">5 min</p>
              <p class="mt-1 text-xs text-cream/60">online intake</p>
            </div>
            <div>
              <p class="font-display text-2xl text-apricot-300">50</p>
              <p class="mt-1 text-xs text-cream/60">states, one clinic</p>
            </div>
            <div>
              <p class="font-display text-2xl text-apricot-300">24/7</p>
              <p class="mt-1 text-xs text-cream/60">care messaging</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What we treat -->
  <section class="bg-white">
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">What we treat</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">
          One clinic for the care you actually use.
        </h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          conditions.map((c) => (
            <article class="rounded-3xl border border-pine-900/10 bg-cream p-8 transition-shadow hover:shadow-lg">
              <h3 class="font-display text-xl font-medium text-pine-900">{c.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{c.body}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-10">
        <a href="/services" class="btn-secondary">Explore all services</a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section>
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">How it works</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">
          From first question to first delivery, in days.
        </h2>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="card">
              <p class="font-display text-3xl text-apricot-500">{s.n}</p>
              <h3 class="mt-4 font-display text-xl font-medium text-pine-900">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why EfhsanRX -->
  <section class="bg-pine-800 text-cream">
    <div class="section grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow !text-apricot-300">Why EfhsanRX</p>
        <h2 class="display mt-4 text-3xl !text-cream sm:text-4xl">
          Built like a clinic, not an app store.
        </h2>
        <p class="mt-6 max-w-lg leading-relaxed text-cream/70">
          Telehealth is easy to start and easy to abandon. We designed EfhsanRX
          around the part that matters most: what happens after your first
          visit.
        </p>
      </div>
      <ul class="space-y-6">
        <li class="rounded-2xl bg-cream/5 p-6">
          <h3 class="font-semibold">A clinician who knows your history</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream/70">
            You're not re-explaining yourself to a stranger every visit. Your
            care team sees your full record and picks up where you left off.
          </p>
        </li>
        <li class="rounded-2xl bg-cream/5 p-6">
          <h3 class="font-semibold">Treatment only when it's right</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream/70">
            We're not a prescription vending machine. Clinicians recommend
            treatment when it's appropriate — and tell you honestly when it
            isn't.
          </p>
        </li>
        <li class="rounded-2xl bg-cream/5 p-6">
          <h3 class="font-semibold">Transparent pricing, up front</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream/70">
            You'll see the full cost of your program before you commit. No
            surprise bills, no fine print.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="section max-w-3xl">
      <p class="eyebrow">Questions</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl">Frequently asked.</h2>
      <div class="mt-10 divide-y divide-pine-900/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-pine-900">
                {f.q}
                <span class="text-pine-400 transition-transform group-open:rotate-45">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="section">
      <div class="card !bg-apricot-100 !p-12 text-center sm:!p-16">
        <h2 class="display mx-auto max-w-2xl text-3xl sm:text-4xl">
          Feel like yourself again — starting this week.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-ink/70">
          Book a virtual visit with a licensed clinician and get a plan built
          for you.
        </p>
        <a href="/book" class="btn-primary mt-8">Book a visit</a>
      </div>
    </div>
  </section>
</Layout>
