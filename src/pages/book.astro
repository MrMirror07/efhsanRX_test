---
import Layout from "../layouts/Layout.astro";
import { SITE, PORTAL_URL, PORTAL_LIVE, PRICING } from "../config";

/**
 * Booking handoff. Once PORTAL_LIVE is true this page explains the three
 * steps inside the secure OptiMantra portal and sends the visitor there.
 * Until then it shows the interim request form so no visitor hits a dead end.
 */
const steps = [
  {
    n: "1",
    title: "Pick a time that fits your week",
    body: "Choose an open slot on the calendar. Evenings and same week times are usually available.",
  },
  {
    n: "2",
    title: "Choose your clinician",
    body: "Book with our board certified ObGyn or our certified nurse midwife. Both read your story before you connect.",
  },
  {
    n: "3",
    title: "Tell us what is going on",
    body: "Describe your concern in your own words. A short secure intake and your consent forms arrive by email right after you book.",
  },
];
---

<Layout
  title="Book a Visit | SheWellRX"
  description="Book a virtual visit with SheWellRX in minutes: pick a time, choose your clinician, and describe your concern in our secure patient portal."
>
  {
    PORTAL_LIVE ? (
      <section class="section grid gap-12 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <p class="eyebrow">Book a visit</p>
          <h1 class="display mt-4 text-4xl sm:text-5xl">Three steps. Under five minutes.</h1>
          <p class="mt-6 leading-relaxed text-ink/70">
            Booking happens in our secure, HIPAA compliant patient portal. You pay
            securely when you book. The initial visit is ${PRICING.initial.price}, flat,
            and follow ups are ${PRICING.followUp.price}.
          </p>
          <a href={PORTAL_URL} class="btn-primary group mt-8 !px-8 !py-4 !text-base" rel="noopener">
            Open the secure portal
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <p class="mt-4 text-xs text-ink/50">
            You will leave shewellrx.com for our patient portal. Your health
            information never touches this website.
          </p>
        </div>
        <div class="lg:col-span-3">
          <ol class="grid gap-4">
            {steps.map((s) => (
              <li class="card flex gap-5 !p-6 sm:!p-8">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-pine-800 font-display text-lg text-cream">
                  {s.n}
                </span>
                <div>
                  <h2 class="font-display text-xl font-medium text-pine-900">{s.title}</h2>
                  <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="mt-6 rounded-3xl border border-pine-900/10 bg-white p-6 text-sm leading-relaxed text-ink/70">
            <p class="font-semibold text-pine-900">What happens after you book</p>
            <p class="mt-2">
              A confirmation email arrives with your secure intake questionnaire,
              your consent forms to sign electronically, and the private video
              link for your visit. Complete the intake before your appointment
              so your clinician can read your story in advance.
            </p>
            <p class="mt-3">
              Questions before booking? Email
              <a href={`mailto:${SITE.email}`} class="font-medium text-apricot-700 underline underline-offset-4">{SITE.email}</a>.
              For emergencies, call 911. This page is not monitored for urgent needs.
            </p>
          </div>
        </div>
      </section>
    ) : (
      <section class="section grid gap-12 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <p class="eyebrow">Book a visit</p>
          <h1 class="display mt-4 text-4xl sm:text-5xl">Let's get you seen.</h1>
          <p class="mt-6 leading-relaxed text-ink/70">
            Tell us a little about what you're looking for and we'll follow up to
            schedule your first visit. It takes less than a minute.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-ink/70">
            <li class="flex gap-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
              </svg>
              No commitment. Your first step is just a conversation.
            </li>
            <li class="flex gap-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
              </svg>
              Your information is kept confidential.
            </li>
            <li class="flex gap-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
              </svg>
              For emergencies, call 911. This form is not monitored for urgent needs.
            </li>
          </ul>
        </div>

        <div class="lg:col-span-3">
          <form id="booking-form" class="card space-y-6" novalidate>
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="first-name" class="block text-sm font-medium text-pine-900">First name</label>
                <input type="text" id="first-name" name="firstName" required autocomplete="given-name"
                  class="mt-2 w-full rounded-xl border border-pine-900/15 bg-cream px-4 py-3 text-sm outline-none transition focus:border-pine-500 focus:ring-2 focus:ring-pine-500/20" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-pine-900">Last name</label>
                <input type="text" id="last-name" name="lastName" required autocomplete="family-name"
                  class="mt-2 w-full rounded-xl border border-pine-900/15 bg-cream px-4 py-3 text-sm outline-none transition focus:border-pine-500 focus:ring-2 focus:ring-pine-500/20" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-pine-900">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email"
                class="mt-2 w-full rounded-xl border border-pine-900/15 bg-cream px-4 py-3 text-sm outline-none transition focus:border-pine-500 focus:ring-2 focus:ring-pine-500/20" />
            </div>
            <div>
              <label for="interest" class="block text-sm font-medium text-pine-900">What brings you in?</label>
              <select id="interest" name="interest" required
                class="mt-2 w-full rounded-xl border border-pine-900/15 bg-cream px-4 py-3 text-sm outline-none transition focus:border-pine-500 focus:ring-2 focus:ring-pine-500/20">
                <option value="">Choose an area of care</option>
                <option>Menopause and perimenopause</option>
                <option>Hot flashes and night sweats</option>
                <option>Irregular or heavy periods</option>
                <option>Birth control and family planning</option>
                <option>Intimacy and comfort</option>
                <option>A general gynecology question</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-pine-900">
                Anything you'd like us to know? <span class="font-normal text-ink/50">(optional)</span>
              </label>
              <textarea id="message" name="message" rows="4"
                class="mt-2 w-full rounded-xl border border-pine-900/15 bg-cream px-4 py-3 text-sm outline-none transition focus:border-pine-500 focus:ring-2 focus:ring-pine-500/20"
                placeholder="Please don't include urgent medical concerns here."></textarea>
            </div>
            <button type="submit" class="btn-accent w-full">Request my visit</button>
            <p id="form-status" data-email={SITE.email}
              class="hidden rounded-xl bg-pine-50 px-4 py-3 text-sm text-pine-800" role="status"></p>
          </form>
        </div>
      </section>
    )
  }
</Layout>

<script>
  // Interim handler while the portal is not yet live: nothing is submitted
  // anywhere; the visitor is told how to reach us instead.
  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (status) {
      status.textContent = `Online booking is opening soon. In the meantime, email ${status.dataset.email} and we'll schedule you directly.`;
      status.classList.remove("hidden");
      status.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });
</script>
