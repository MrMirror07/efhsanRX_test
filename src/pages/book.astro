---
import Layout from "../layouts/Layout.astro";
import { SITE, PRICING, PORTAL_LIVE, OPTIMANTRA, REVIEWS, DOCTOR, SCREEN_MEDICARE } from "../config";

/**
 * Guided start. Everything on this page runs in the visitor's browser and is
 * never stored or transmitted: it exists to route her to the right visit,
 * screen out emergencies and situations we cannot treat by video, and show
 * the full price before she commits. Booking, consents, identity, intake, and
 * payment all happen inside OptiMantra (BAA covered) on the next page.
 *
 * Deep links: /book?concern=<key> skips the first question,
 * /book?type=followup preselects the follow up visit.
 */

type Question = {
  id: string;
  prompt: string;
  sub?: string;
  multi?: boolean;
  options: string[];
};

type Concern = {
  key: string;
  label: string;
  slug: string | null;
  headline: string;
  body: string;
  questions: Question[];
};

const concerns: Concern[] = [
  {
    key: "menopause",
    label: "Perimenopause or menopause symptoms",
    slug: "menopause",
    headline: "Hot flashes, night sweats, and disrupted sleep respond to treatment.",
    body: "Vasomotor symptoms (hot flashes and night sweats), sleep disruption, and mood changes are treated together in one care plan. Menopausal hormone therapy and non hormonal options are prescribed during your visit when they are appropriate for you.",
    questions: [
      {
        id: "stage",
        prompt: "Where are you in the menopause transition?",
        sub: "There is no wrong answer. It helps your clinician prepare for your visit.",
        options: [
          "Periods are still regular, but symptoms have begun",
          "Periods are irregular or skipped",
          "No period for twelve months or more",
          "I have had a hysterectomy or my ovaries removed",
          "Not sure",
        ],
      },
      {
        id: "bothers",
        prompt: "Which symptoms concern you most?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "Hot flashes or night sweats",
          "Sleep disruption",
          "Mood changes or anxiety",
          "Brain fog or difficulty concentrating",
          "Vaginal dryness or pain with intimacy",
          "Weight changes",
          "Low sexual desire",
          "Something else",
        ],
      },
    ],
  },
  {
    key: "hormone-therapy",
    label: "Hormone therapy: starting, adjusting, or a second opinion",
    slug: "hormone-therapy",
    headline: "Your hormone therapy decision, made with a specialist.",
    body: "Menopausal hormone therapy (MHT), started at the appropriate dose for you, can improve daily life. Your clinician screens for the conditions that make it unsafe and builds a care plan that is reviewed at every follow-up visit.",
    questions: [
      {
        id: "goal",
        prompt: "Which of these is closest to your goal?",
        options: [
          "I would like to start hormone therapy",
          "I am taking it and would like it adjusted",
          "I was told I cannot take it and would like a second opinion",
          "I would like to stop it safely",
        ],
      },
      {
        id: "tried",
        prompt: "What have you tried so far?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "Nothing yet",
          "Non hormonal medication",
          "Supplements",
          "Hormone therapy in the past",
          "Something else",
        ],
      },
    ],
  },
  {
    key: "birth-control",
    label: "Birth control",
    slug: "birth-control",
    headline: "A method that fits your body and your plans, prescribed in one visit.",
    body: "The pill, the patch, and the ring are reviewed with your health history and preferences in mind. When a method is appropriate for you, your prescription is sent to your pharmacy the same day.",
    questions: [
      {
        id: "goal",
        prompt: "Which of these applies to you?",
        options: [
          "Start a method",
          "Switch to a different method",
          "Renew a prescription",
          "Guidance on emergency contraception",
        ],
      },
      {
        id: "prefs",
        prompt: "Do you have any preferences?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "The pill",
          "The patch",
          "The ring",
          "Fewer or no periods",
          "An estrogen free method",
          "Not sure, I would like guidance",
        ],
      },
    ],
  },
  {
    key: "intimacy",
    label: "Vaginal dryness, pain with intimacy, or low desire",
    slug: "sexual-health",
    headline: "Vaginal dryness, discomfort, and low desire are medical conditions with effective treatment.",
    body: "Vaginal dryness, irritation, pain with intimacy, and low sexual desire are evaluated in a private video visit. Vaginal estrogen and other treatments are prescribed when they are appropriate for you.",
    questions: [
      {
        id: "symptoms",
        prompt: "What are you experiencing?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "Vaginal dryness",
          "Pain with intimacy",
          "Low sexual desire",
          "Burning or urinary symptoms",
          "Something else",
        ],
      },
      {
        id: "duration",
        prompt: "How long have you noticed this?",
        options: ["Weeks", "Months", "Years"],
      },
    ],
  },
  {
    key: "periods",
    label: "Period concerns: heavy bleeding, painful or irregular cycles, polycystic ovary syndrome (PCOS)",
    slug: "periods",
    headline: "Heavy, painful, or irregular cycles are evaluated carefully and treated.",
    body: "Heavy menstrual bleeding, painful periods, irregular cycles, and polycystic ovary syndrome (PCOS) receive a structured evaluation and a written care plan. Laboratory tests are ordered only when the results would change your plan.",
    questions: [
      {
        id: "pattern",
        prompt: "What have you noticed about your cycle?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "Heavy bleeding",
          "Painful periods",
          "Irregular or absent periods",
          "Bleeding between periods",
          "Diagnosed or suspected PCOS",
        ],
      },
      {
        id: "duration",
        prompt: "How long has this been happening?",
        options: ["New, under three months", "Three to twelve months", "Years"],
      },
    ],
  },
  {
    key: "labs",
    label: "Lab work, screenings, or hormone testing",
    slug: "labs",
    headline: "Lab work that answers your question, explained clearly.",
    body: "When your care plan calls for testing, we order what will inform the decision, arrange for you to visit a laboratory near your home, and review every line of your results with you.",
    questions: [
      {
        id: "wants",
        prompt: "What would you like checked?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "Hormone levels",
          "Thyroid function",
          "Preventive screening appropriate for my age",
          "A result I already have and would like explained",
          "Not sure",
        ],
      },
      {
        id: "results",
        prompt: "Do you have recent lab results?",
        options: ["Yes, from the last twelve months", "No"],
      },
    ],
  },
  {
    key: "else",
    label: "Something else in women's health",
    slug: null,
    headline: "Whatever your concern in women's health, a visit is the place to begin.",
    body: "From hormone questions to a screening you have been meaning to schedule, a video visit is the most direct path to a clear answer. If your concern is better served elsewhere, your clinician will say so and refer you to the appropriate care.",
    questions: [
      {
        id: "kind",
        prompt: "Which of these is closest to your concern?",
        sub: "Select all that apply.",
        multi: true,
        options: [
          "A symptom I would like explained",
          "A diagnosis I would like a second opinion on",
          "A prescription renewal",
          "A general question",
          "Not sure",
        ],
      },
      {
        id: "duration",
        prompt: "How long has this concerned you?",
        options: ["Days", "Weeks", "Months or longer"],
      },
    ],
  },
];

const goals: Question = {
  id: "goals",
  prompt: "What would you like from this visit?",
  sub: "Select all that apply. At the end, you can copy your answers into your intake so your clinician can review them before the visit.",
  multi: true,
  options: [
    "A prescription, if it is appropriate for me",
    "To understand what I am experiencing",
    "A second opinion",
    "Ongoing care with one clinician",
    "Lab work",
    "Not sure yet",
  ],
};

const redFlags = [
  "Bleeding that soaks through a pad or tampon every hour for two hours or more",
  "Severe pelvic or abdominal pain, fainting, or fever with pelvic pain",
  "A positive pregnancy test with pain or bleeding",
  "Chest pain, difficulty breathing, or a severe headache with vision changes",
  "Thoughts of harming yourself",
];

const initialUrl = OPTIMANTRA.services.initial.url;
const followUpUrl = OPTIMANTRA.services.followUp.url;
const optionClass =
  "flow-option group flex w-full items-center gap-4 rounded-2xl border border-pine-900/15 bg-white px-5 py-4 text-left text-sm font-medium leading-snug transition-all duration-200 hover:border-pine-500 hover:shadow-md aria-pressed:border-pine-700 aria-pressed:bg-pine-50";
---

<Layout
  title="Start Your Visit | SheWellRX"
  description="A two minute check, the full price in advance, then choose a time and pay securely. Video visits with a board certified ObGyn for women in New Jersey."
>
  <section class="section !py-10 sm:!py-16">
    <div class="mx-auto max-w-2xl">
      <!-- Phase progress -->
      <ol id="flow-phases" class="grid grid-cols-3 gap-2 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-ink/40 sm:text-xs" aria-label="Progress">
        <li data-phase="1" class="flow-phase"><span class="block h-1 rounded-full bg-pine-900/10 transition-colors duration-500"></span><span class="mt-2 block">Your concern</span></li>
        <li data-phase="2" class="flow-phase"><span class="block h-1 rounded-full bg-pine-900/10 transition-colors duration-500"></span><span class="mt-2 block">Quick check</span></li>
        <li data-phase="3" class="flow-phase"><span class="block h-1 rounded-full bg-pine-900/10 transition-colors duration-500"></span><span class="mt-2 block">Book and pay</span></li>
      </ol>

      <div id="flow" data-screen-medicare={SCREEN_MEDICARE ? "1" : ""} class="mt-8 rounded-[2rem] bg-white p-6 shadow-[0_1px_2px_rgba(20,43,38,0.06),0_12px_32px_-16px_rgba(20,43,38,0.18)] sm:p-10">
        <div class="flex items-center justify-between">
          <button type="button" id="flow-back" class="inline-flex items-center gap-1 text-xs font-medium text-pine-500 transition-colors hover:text-pine-700" style="display:none">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" /></svg>
            Back
          </button>
          <p class="ml-auto text-xs text-ink/40">Your answers on this page are not stored or sent anywhere.</p>
        </div>

        <!-- 1. Concern -->
        <div data-step="concern" class="flow-step mt-6">
          <p class="eyebrow">Your concern</p>
          <h1 class="display mt-3 text-3xl sm:text-4xl">What would you like help with today?</h1>
          <p class="mt-3 text-sm text-ink/60">Choose the closest match. You can describe your concern in full in your intake after you book.</p>
          <div class="mt-6 grid gap-2">
            {concerns.map((c) => (
              <button type="button" class={optionClass} data-answer="concern" data-value={c.key}>
                <span class="flex-1">{c.label}</span>
                <svg class="h-4 w-4 shrink-0 text-pine-400 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" /></svg>
              </button>
            ))}
          </div>
        </div>

        <!-- 2. Concern specific fit questions -->
        {concerns.map((c) =>
          c.questions.map((q, i) => (
            <div data-step={`fit-${c.key}-${i}`} data-concern={c.key} data-next={i + 1 < c.questions.length ? `fit-${c.key}-${i + 1}` : "goals"} class="flow-step mt-6 hidden">
              <p class="eyebrow">Your concern</p>
              <h2 class="display mt-3 text-2xl sm:text-3xl">{q.prompt}</h2>
              {q.sub && <p class="mt-3 text-sm text-ink/60">{q.sub}</p>}
              <div class="mt-6 grid gap-2" role={q.multi ? "group" : undefined}>
                {q.options.map((o) => (
                  <button type="button" class={optionClass} data-answer={q.multi ? "multi" : "single"} data-key={`${c.key}.${q.id}`} data-label={q.prompt} data-value={o} aria-pressed="false">
                    {q.multi && (
                      <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-pine-900/25 text-cream transition-colors group-aria-pressed:border-pine-700 group-aria-pressed:bg-pine-700" aria-hidden="true">
                        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                      </span>
                    )}
                    <span class="flex-1">{o}</span>
                  </button>
                ))}
              </div>
              {q.multi && <button type="button" class="btn-primary mt-6 w-full flow-continue" disabled>Continue</button>}
            </div>
          )),
        )}

        <!-- 3. Goals (why you want to be seen) -->
        <div data-step="goals" data-next="reassure" class="flow-step mt-6 hidden">
          <p class="eyebrow">Your concern</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">{goals.prompt}</h2>
          <p class="mt-3 text-sm text-ink/60">{goals.sub}</p>
          <div class="mt-6 grid gap-2" role="group">
            {goals.options.map((o) => (
              <button type="button" class={optionClass} data-answer="multi" data-key="goals" data-label="Goals" data-value={o} aria-pressed="false">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-pine-900/25 text-cream transition-colors group-aria-pressed:border-pine-700 group-aria-pressed:bg-pine-700" aria-hidden="true">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                </span>
                <span class="flex-1">{o}</span>
              </button>
            ))}
          </div>
          <button type="button" class="btn-primary mt-6 w-full flow-continue" disabled>Continue</button>
        </div>

        <!-- 4. Reassurance, one per concern -->
        {concerns.map((c) => (
          <div data-step={`reassure-${c.key}`} class="flow-step mt-6 hidden">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-apricot-700">You are in the right place</p>
            <h2 class="display mt-3 text-2xl sm:text-3xl">{c.headline}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{c.body}</p>
            <ul class="mt-6 grid gap-2 text-sm text-ink/80 sm:grid-cols-2">
              <li class="rounded-xl bg-cream px-4 py-3">Board certified ObGyn since {DOCTOR.boardCertifiedSince}</li>
              <li class="rounded-xl bg-cream px-4 py-3">{REVIEWS.google.rating} stars across {REVIEWS.google.count} Google reviews</li>
              <li class="rounded-xl bg-cream px-4 py-3">Thirty minute video visits</li>
              <li class="rounded-xl bg-cream px-4 py-3">One transparent self-pay price</li>
            </ul>
            <button type="button" class="btn-primary mt-6 w-full" data-go="safety">Continue to the safety check</button>
            {c.slug && (
              <a href={`/services#${c.slug}`} class="mt-3 block text-center text-xs font-medium text-pine-600 underline underline-offset-4 hover:text-pine-800">Read how this concern is treated</a>
            )}
          </div>
        ))}

        <!-- 5. Safety -->
        <div data-step="safety" class="flow-step mt-6 hidden">
          <p class="eyebrow">Quick check</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">First, a brief safety check.</h2>
          <p class="mt-3 text-sm text-ink/60">A few situations call for emergency care rather than a video visit. If any of these is happening now, please seek care immediately.</p>
          <div class="mt-6 grid gap-2">
            <button type="button" class={optionClass} data-answer="safety" data-value="none">
              <span class="flex-1">None of these</span>
            </button>
            {redFlags.map((f) => (
              <button type="button" class={optionClass} data-answer="safety" data-value="flag">
                <span class="flex-1">{f}</span>
              </button>
            ))}
          </div>
        </div>

        <div data-step="stop-safety" class="flow-step mt-6 hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-apricot-700">Please seek care now</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Call 911 or go to the nearest emergency room.</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            SheWellRX is not an emergency service and cannot respond quickly enough in these situations. If you are having thoughts of harming yourself, call or text 988 to reach the Suicide and Crisis Lifeline. Once you are safe, we are here for your follow-up care.
          </p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <a href="tel:911" class="btn-accent w-full">Call 911</a>
            <a href="sms:988" class="btn-secondary w-full">Text 988</a>
          </div>
          <button type="button" class="mt-4 block w-full text-center text-xs font-medium text-pine-600 underline underline-offset-4" data-go="safety">I selected this by mistake, take me back</button>
        </div>

        <!-- 6. Pregnancy -->
        <div data-step="pregnancy" class="flow-step mt-6 hidden">
          <p class="eyebrow">Quick check</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Are you currently pregnant?</h2>
          <p class="mt-3 text-sm text-ink/60">Pregnancy changes which treatments are safe, so we ask early. Prenatal care requires examinations and ultrasounds that cannot be performed by video.</p>
          <div class="mt-6 grid gap-2">
            <button type="button" class={optionClass} data-answer="pregnancy" data-value="no"><span class="flex-1">No</span></button>
            <button type="button" class={optionClass} data-answer="pregnancy" data-value="planning"><span class="flex-1">Not currently, but planning a pregnancy within the next year</span></button>
            <button type="button" class={optionClass} data-answer="pregnancy" data-value="yes"><span class="flex-1">Yes, or I may be</span></button>
          </div>
        </div>

        <div data-step="stop-pregnancy" class="flow-step mt-6 hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pine-500">Our recommendation</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Pregnancy care is best provided in person.</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            SheWellRX is a fully virtual practice, and prenatal care requires in-person examinations and ultrasounds. A video visit does not replace an examination when one is needed. Write to us and we will help you find in-person obstetric care near you.
          </p>
          <a href={`mailto:${SITE.email}?subject=Prenatal%20care%20guidance`} class="btn-primary mt-6 w-full">Email us for guidance</a>
        </div>

        <!-- 7. Location -->
        <div data-step="location" class="flow-step mt-6 hidden">
          <p class="eyebrow">Quick check</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Will you be in New Jersey at the time of your visit?</h2>
          <p class="mt-3 text-sm text-ink/60">Your clinician is licensed in New Jersey and can treat you only while you are physically in the state. You will confirm this again when you book.</p>
          <div class="mt-6 grid gap-2">
            <button type="button" class={optionClass} data-answer="location" data-value="yes"><span class="flex-1">Yes</span></button>
            <button type="button" class={optionClass} data-answer="location" data-value="no"><span class="flex-1">No</span></button>
          </div>
        </div>

        <div data-step="stop-location" class="flow-step mt-6 hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pine-500">Before you book</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Visits are available only while you are in New Jersey.</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            Your clinician is licensed in New Jersey, so care can be provided only while you are in the state. If you will be visiting soon, you may schedule for a day you will be here. Otherwise, let us know where you live and we will tell you if care becomes available in your state.
          </p>
          <a href={`mailto:${SITE.email}?subject=Bring%20SheWellRX%20to%20my%20state`} class="btn-primary mt-6 w-full">Tell us your state</a>
          <button type="button" class="mt-3 block w-full text-center text-xs font-medium text-pine-600 underline underline-offset-4" data-go="age">I will be in New Jersey, continue</button>
        </div>

        <!-- 8. Age -->
        <div data-step="age" class="flow-step mt-6 hidden">
          <p class="eyebrow">Quick check</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Are you 18 or older?</h2>
          <p class="mt-3 text-sm text-ink/60">You must be an adult to schedule care for yourself. Your date of birth is collected in the secure patient portal, not on this page.</p>
          <div class="mt-6 grid gap-2">
            <button type="button" class={optionClass} data-answer="age" data-value="yes"><span class="flex-1">Yes</span></button>
            <button type="button" class={optionClass} data-answer="age" data-value="no"><span class="flex-1">No</span></button>
          </div>
        </div>

        <div data-step="stop-age" class="flow-step mt-6 hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pine-500">Before you book</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Video visits are available to adults only.</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            If you are under 18, a parent or guardian can contact a pediatric or adolescent gynecology practice near you. Your pediatrician or school nurse can also help you find one.
          </p>
          <a href="/" class="btn-secondary mt-6 w-full">Return to the home page</a>
        </div>

        <!-- 8b. Medicare and Medicaid (shown only while SCREEN_MEDICARE is true) -->
        <div data-step="coverage" class="flow-step mt-6 hidden">
          <p class="eyebrow">Quick check</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Are you enrolled in Medicare or Medicaid?</h2>
          <p class="mt-3 text-sm text-ink/60">SheWellRX is a self-pay practice and does not bill insurance. Federal rules limit how Medicare and Medicaid enrollees may pay privately for care, so we ask before you book.</p>
          <div class="mt-6 grid gap-2">
            <button type="button" class={optionClass} data-answer="coverage" data-value="no"><span class="flex-1">No</span></button>
            <button type="button" class={optionClass} data-answer="coverage" data-value="medicare"><span class="flex-1">Yes, Medicare (including Medicare Advantage)</span></button>
            <button type="button" class={optionClass} data-answer="coverage" data-value="medicaid"><span class="flex-1">Yes, Medicaid or NJ FamilyCare</span></button>
          </div>
        </div>

        <div data-step="stop-coverage" class="flow-step mt-6 hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pine-500">Before you book</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">Let us review your options first.</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">
            Medicare and Medicaid have their own rules about paying a physician directly, and we want to be certain your visit is arranged correctly. Email us with the program you are enrolled in, and we will explain what is possible and how you can be seen.
          </p>
          <a href={`mailto:${SITE.email}?subject=Medicare%20or%20Medicaid%20patient`} class="btn-primary mt-6 w-full">Email us about my coverage</a>
        </div>

        <!-- 9. Visit type, price, and handoff -->
        <div data-step="visit" class="flow-step mt-6 hidden">
          <p class="eyebrow">Book and pay</p>
          <h2 class="display mt-3 text-2xl sm:text-3xl">You can schedule your video visit.</h2>
          <div class="mt-4 rounded-2xl border border-pine-900/10 bg-cream p-4 text-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-pine-500">Your visit summary</p>
            <p id="flow-summary" class="mt-2 leading-relaxed text-ink/80"></p>
            <button type="button" id="flow-copy" class="mt-3 text-xs font-medium text-pine-600 underline underline-offset-4 hover:text-pine-800">Copy this summary to paste into your intake</button>
          </div>

          <p class="mt-6 text-sm font-medium text-pine-900">Choose your visit</p>
          <div class="mt-3 grid gap-3">
            <button type="button" class="flow-visit rounded-2xl border border-pine-900/15 bg-white p-5 text-left transition-all hover:border-pine-500 aria-pressed:border-pine-700 aria-pressed:bg-pine-50" data-visit="initial" aria-pressed="true">
              <span class="flex items-baseline justify-between gap-4">
                <span class="font-display text-lg font-medium text-pine-900">{PRICING.initial.label}</span>
                <span class="font-display text-2xl text-pine-900">${PRICING.initial.price}</span>
              </span>
              <span class="mt-1 block text-xs text-ink/60">{PRICING.initial.duration} video visit, paid once. For patients new to SheWellRX.</span>
            </button>
            <button type="button" class="flow-visit rounded-2xl border border-pine-900/15 bg-white p-5 text-left transition-all hover:border-pine-500 aria-pressed:border-pine-700 aria-pressed:bg-pine-50" data-visit="followup" aria-pressed="false">
              <span class="flex items-baseline justify-between gap-4">
                <span class="font-display text-lg font-medium text-pine-900">{PRICING.followUp.label}</span>
                <span class="font-display text-2xl text-pine-900">${PRICING.followUp.price}</span>
              </span>
              <span class="mt-1 block text-xs text-ink/60">{PRICING.followUp.duration} video visit for patients already in our care.</span>
            </button>
          </div>

          <div class="mt-6 rounded-2xl border border-pine-900/10 bg-white p-5 text-sm leading-relaxed text-ink/70">
            <p class="font-semibold text-pine-900">Your Good Faith Estimate</p>
            <p class="mt-2">
              As a self-pay patient, you are entitled to know the full cost in advance. The visit fee is the only charge from SheWellRX:
              <strong class="text-pine-900" id="flow-price">${PRICING.initial.price}</strong> for the visit you chose, paid once when you book. Medications and laboratory tests, if any, are billed separately by your pharmacy or laboratory at their own prices. You may cancel or reschedule up to 24 hours before your visit for a full refund.
              <a href="/good-faith-estimate" class="font-medium text-apricot-700 underline underline-offset-4">Read the full estimate</a>.
            </p>
          </div>

          <p class="mt-6 text-xs leading-relaxed text-ink/60">
            Next, you will choose a time, create your secure patient portal account, confirm that you are in New Jersey and 18 or older, sign the
            <a href="/telehealth-consent" class="underline underline-offset-4">Telehealth Consent and Terms of Care</a>, and pay. Your health information is entered only inside the portal, not on this website. After payment, your confirmation email includes two short forms, the consent and your intake questionnaire; please complete them before your visit.
          </p>

          {PORTAL_LIVE ? (
            <a id="flow-cta" href={initialUrl} data-initial={initialUrl} data-followup={followUpUrl} class="btn-accent group mt-6 w-full !py-4 !text-base" rel="noopener">
              <span>Choose a time and pay</span>
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </a>
          ) : (
            <div class="mt-6 rounded-2xl bg-pine-50 p-5 text-sm leading-relaxed text-pine-900">
              <p class="font-semibold">Online scheduling will open shortly.</p>
              <p class="mt-2">
                Email <a href={`mailto:${SITE.email}?subject=Book%20my%20visit`} class="font-medium text-apricot-700 underline underline-offset-4">{SITE.email}</a> with the visit you chose and a few times that suit you. We reply within one business day with your secure booking link, and payment is made only once your time is confirmed.
              </p>
              <a id="flow-cta" href={`mailto:${SITE.email}?subject=Book%20my%20visit`} class="btn-accent mt-4 w-full">Email us to schedule</a>
            </div>
          )}
          <p class="mt-4 text-center text-xs text-ink/50">
            Already a patient? <a href={OPTIMANTRA.portalLoginUrl} rel="noopener" class="font-medium text-pine-600 underline underline-offset-4">Sign in to the patient portal</a>.
          </p>
        </div>

        <button type="button" id="flow-restart" style="display:none" class="mt-6 text-xs font-medium text-pine-500 underline underline-offset-4 hover:text-pine-700">Start over</button>
      </div>

      <p class="mx-auto mt-8 max-w-xl text-center text-xs leading-relaxed text-ink/50">
        For emergencies, call 911. This page is not monitored for urgent needs. If you have questions before booking, email
        <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">{SITE.email}</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  // Guided start. State lives in this closure only: nothing is written to
  // storage or sent over the network. The final button carries just the
  // OptiMantra service link; the summary is offered as copyable text so the
  // patient can paste it into her secure intake if she wishes.
  const root = document.getElementById("flow");
  if (root) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
    const phases = document.querySelectorAll<HTMLElement>("#flow-phases .flow-phase");
    const back = document.getElementById("flow-back") as HTMLButtonElement | null;
    const restart = document.getElementById("flow-restart") as HTMLButtonElement | null;
    const summaryEl = document.getElementById("flow-summary");
    const priceEl = document.getElementById("flow-price");
    const cta = document.getElementById("flow-cta") as HTMLAnchorElement | null;
    const copyBtn = document.getElementById("flow-copy") as HTMLButtonElement | null;

    const stepEl = (id: string) => steps.find((s) => s.dataset.step === id);
    const history: string[] = [];
    let current = "concern";
    let concern = "";
    let visit: "initial" | "followup" = "initial";
    // Answers keyed by question, each a list of chosen labels, plus the prompt.
    const answers = new Map<string, { label: string; values: string[] }>();

    const screenMedicare = root.dataset.screenMedicare === "1";
    const phaseOf = (id: string) => {
      if (id === "visit") return 3;
      if (id === "safety" || id === "pregnancy" || id === "location" || id === "age" || id === "coverage" || id.startsWith("stop-")) return 2;
      return 1;
    };

    const buildSummary = () => {
      const c = root.querySelector<HTMLButtonElement>(`[data-answer="concern"][data-value="${concern}"]`);
      const parts: string[] = [];
      if (c) parts.push(`Concern: ${c.textContent?.trim()}`);
      answers.forEach((a) => {
        if (a.label && a.values.length) parts.push(`${a.label}: ${a.values.join(", ")}`);
      });
      const preg = answers.get("pregnancy");
      if (preg?.values[0] === "planning") parts.push("Planning a pregnancy in the next year");
      return parts.join(". ") + ".";
    };

    const applyVisit = () => {
      root.querySelectorAll<HTMLButtonElement>(".flow-visit").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.visit === visit)));
      if (priceEl) priceEl.textContent = visit === "initial" ? "$249" : "$149";
      if (cta && cta.dataset.initial) cta.href = visit === "initial" ? cta.dataset.initial : (cta.dataset.followup ?? cta.dataset.initial);
    };

    const render = () => {
      steps.forEach((el) => {
        const on = el.dataset.step === current;
        el.classList.toggle("hidden", !on);
        if (on) {
          el.classList.remove("fit-in");
          void el.offsetWidth;
          el.classList.add("fit-in");
          el.querySelector<HTMLElement>("h1, h2")?.focus?.();
        }
      });
      const p = phaseOf(current);
      phases.forEach((ph, i) => {
        const bar = ph.firstElementChild as HTMLElement;
        const on = i < p;
        bar.classList.toggle("bg-pine-800", on);
        bar.classList.toggle("bg-pine-900/10", !on);
        ph.classList.toggle("text-pine-800", i === p - 1);
      });
      if (back) back.style.display = history.length ? "" : "none";
      if (restart) restart.style.display = current === "concern" ? "none" : "";
      if (current === "visit") {
        if (summaryEl) summaryEl.textContent = buildSummary();
        applyVisit();
      }
      window.scrollTo({ top: Math.max(0, root.getBoundingClientRect().top + window.scrollY - 96), behavior: "smooth" });
    };

    const go = (next: string) => {
      history.push(current);
      current = next;
      render();
    };

    // Single and multi select answers inside the fit questions.
    root.querySelectorAll<HTMLButtonElement>("button[data-answer]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kind = btn.dataset.answer;
        const value = btn.dataset.value ?? "";
        const step = btn.closest<HTMLElement>("[data-step]");
        if (!step) return;
        if (kind === "concern") {
          concern = value;
          answers.clear();
          go(`fit-${concern}-0`);
        } else if (kind === "single") {
          answers.set(btn.dataset.key ?? "", { label: btn.dataset.label ?? "", values: [value] });
          go(step.dataset.next ?? "goals");
        } else if (kind === "multi") {
          const key = btn.dataset.key ?? "";
          const entry = answers.get(key) ?? { label: btn.dataset.label ?? "", values: [] };
          const pressed = btn.getAttribute("aria-pressed") === "true";
          btn.setAttribute("aria-pressed", String(!pressed));
          entry.values = pressed ? entry.values.filter((v) => v !== value) : [...entry.values, value];
          answers.set(key, entry);
          const cont = step.querySelector<HTMLButtonElement>(".flow-continue");
          if (cont) cont.disabled = entry.values.length === 0;
        } else if (kind === "safety") {
          go(value === "flag" ? "stop-safety" : "pregnancy");
        } else if (kind === "pregnancy") {
          answers.set("pregnancy", { label: "", values: [value] });
          go(value === "yes" ? "stop-pregnancy" : "location");
        } else if (kind === "location") {
          go(value === "yes" ? "age" : "stop-location");
        } else if (kind === "age") {
          go(value === "yes" ? (screenMedicare ? "coverage" : "visit") : "stop-age");
        } else if (kind === "coverage") {
          go(value === "no" ? "visit" : "stop-coverage");
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>(".flow-continue").forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = btn.closest<HTMLElement>("[data-step]");
        const next = step?.dataset.next ?? "goals";
        go(next === "reassure" ? `reassure-${concern}` : next);
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((btn) => {
      btn.addEventListener("click", () => go(btn.dataset.go ?? "concern"));
    });

    root.querySelectorAll<HTMLButtonElement>(".flow-visit").forEach((btn) => {
      btn.addEventListener("click", () => {
        visit = btn.dataset.visit === "followup" ? "followup" : "initial";
        applyVisit();
      });
    });

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(buildSummary());
        copyBtn.textContent = "Copied. Paste it into the intake after you book.";
      } catch {
        copyBtn.textContent = "Select the text above to copy it.";
      }
    });

    back?.addEventListener("click", () => {
      const prev = history.pop();
      if (prev) {
        current = prev;
        render();
      }
    });

    restart?.addEventListener("click", () => {
      history.length = 0;
      answers.clear();
      concern = "";
      current = "concern";
      root.querySelectorAll<HTMLButtonElement>('[data-answer="multi"]').forEach((b) => b.setAttribute("aria-pressed", "false"));
      root.querySelectorAll<HTMLButtonElement>(".flow-continue").forEach((b) => (b.disabled = true));
      render();
    });

    // Deep links from tiles and the home page picker.
    const params = new URLSearchParams(location.search);
    const pre = params.get("concern");
    if (params.get("type") === "followup") visit = "followup";
    if (pre && stepEl(`fit-${pre}-0`)) {
      concern = pre;
      current = `fit-${pre}-0`;
      history.push("concern");
    }
    render();
  }
</script>
