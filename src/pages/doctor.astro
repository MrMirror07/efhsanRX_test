---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Stars from "../components/Stars.astro";
import { SITE, DOCTOR, DOCTOR2, PRACTICE, PORTAL_URL, REVIEWS } from "../config";
import portraitUpward from "../assets/portrait-upward.png";
import drCopur from "../assets/dr-copur.jpg";
import nurefsan from "../assets/nurefsan-copur.jpg";

const ratings = [
  { platform: "Google", rating: REVIEWS.google.rating, count: REVIEWS.google.count, url: PRACTICE.googleMapsUrl },
  { platform: "Healthgrades", rating: REVIEWS.healthgrades.rating, count: REVIEWS.healthgrades.count, url: "https://www.healthgrades.com/physician/dr-huseyin-copur-yvmm8" },
  { platform: "Zocdoc", rating: REVIEWS.zocdoc.rating, count: REVIEWS.zocdoc.count, url: "https://www.zocdoc.com/doctor/huseyin-copur-md-433548" },
  { platform: "Vitals", rating: REVIEWS.vitals.rating, count: REVIEWS.vitals.count, url: "https://www.vitals.com/doctors/Dr_Huseyin_Copur.html" },
];

const teamSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Physician",
      name: DOCTOR.name,
      url: `${SITE.url}/doctor`,
      medicalSpecialty: "Gynecologic",
      worksFor: { "@type": "MedicalClinic", name: SITE.name, url: SITE.url },
      knowsLanguage: DOCTOR.languages,
      areaServed: { "@type": "State", name: "New Jersey" },
    },
    {
      "@type": "Person",
      name: DOCTOR2.name,
      honorificSuffix: DOCTOR2.credentials,
      jobTitle: "Certified Nurse Midwife",
      url: `${SITE.url}/doctor`,
      worksFor: { "@type": "MedicalClinic", name: SITE.name, url: SITE.url },
      knowsLanguage: DOCTOR2.languages,
    },
  ],
};
---

<Layout
  title={`Your Clinicians | ${SITE.name}`}
  description={`Your care team at SheWellRX: ${DOCTOR.name}, board certified ObGyn (ABOG) rated ${REVIEWS.google.rating} on Google, and ${DOCTOR2.shortName}, certified nurse midwife, joining soon.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(teamSchema)} />

  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-24 right-[-8%] h-[24rem] w-[24rem] rounded-full bg-pine-100 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="section relative grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Your clinicians</p>
        <h1 class="display mt-4 text-4xl sm:text-5xl">
          One promise: you will be heard.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-ink/70">
          SheWellRX is a small practice with two clinicians: {DOCTOR.name}, a
          board certified ObGyn, and {DOCTOR2.name}, a certified nurse midwife
          who joins the practice soon. Your care stays with the same team from
          one visit to the next, and at each follow-up visit your history is
          already known to the clinician on your screen.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink/70">
          Today every visit is a thirty minute video visit with Dr. Copur.
          Once visits with Nurefsan Copur open, you will be told who your
          visit is with at the time you schedule, and you may always request
          the physician.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={PORTAL_URL} class="btn-primary">Schedule a video visit</a>
          <a href={PRACTICE.googleMapsUrl} rel="noopener" target="_blank" class="btn-secondary">
            Read patient reviews on Google
          </a>
        </div>
      </div>
      <figure class="relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-[2.5rem] bg-sand">
        <Image
          src={drCopur}
          alt={`${DOCTOR.name}, board certified obstetrician gynecologist`}
          class="h-full w-full object-cover object-top"
          widths={[480, 600]}
          sizes="(min-width: 1024px) 28rem, 90vw"
          loading="eager"
        />
        <figcaption class="absolute bottom-4 left-4 right-4 rounded-2xl bg-cream/90 px-4 py-3 text-sm backdrop-blur">
          <span class="font-semibold text-pine-900">{DOCTOR.name}</span>
          <span class="block text-xs text-ink/60">Board certified in obstetrics and gynecology (ABOG) · New Jersey</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">The care team</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Who you will see at your visit.</h2>
        <p class="mt-4 leading-relaxed text-ink/70">
          Each clinician's name, license type, and credentials are listed
          here, and you are told who your visit is with at the time you
          schedule.
        </p>
      </div>
      <div class="mt-12 grid gap-8 lg:grid-cols-2" data-reveal-stagger>
        <article class="card flex flex-col !p-10">
          <div class="flex items-center gap-5">
            <Image src={drCopur} alt={`${DOCTOR.name}, board certified ObGyn`} width={160} height={160} class="h-20 w-20 shrink-0 rounded-3xl object-cover object-top shadow-md" />
            <div>
              <h3 class="font-display text-2xl font-medium text-pine-900">{DOCTOR.name}</h3>
              <p class="mt-1 text-sm font-medium text-apricot-700">Physician · Board certified in Obstetrics and Gynecology (ABOG)</p>
              <span class="mt-2 inline-block rounded-full bg-pine-100 px-3 py-1 text-xs font-semibold text-pine-800">Scheduling video visits now</span>
            </div>
          </div>
          <p class="mt-6 leading-relaxed text-ink/70">
            Patients receive an unhurried visit with a clinician who listens.
            His experience includes more than thirty five years of caring for
            women, and patient reviews describe the same qualities: patient,
            kind, thorough, and honest. Your full history is reviewed before
            your visit and remembered at every follow-up visit.
          </p>
          <p class="eyebrow mt-6">What he helps with</p>
          <ul class="mt-3 grid gap-2 text-sm text-ink/80">
            <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-apricot-400" aria-hidden="true"></span>Perimenopause and menopause, including menopausal hormone therapy</li>
            <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-apricot-400" aria-hidden="true"></span>Heavy, painful, or irregular cycles, and polycystic ovary syndrome (PCOS)</li>
            <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-apricot-400" aria-hidden="true"></span>Vaginal dryness, pain with intimacy, and low sexual desire</li>
            <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-apricot-400" aria-hidden="true"></span>Contraception, and laboratory testing when it will guide your care</li>
          </ul>
          <ul class="mt-6 grid gap-2 text-sm text-ink/80">
            <li class="rounded-xl bg-cream px-4 py-3">Board certified in obstetrics and gynecology by the American Board of Obstetrics and Gynecology (an ABMS member board) since {DOCTOR.boardCertifiedSince}, FACOG</li>
            <li class="rounded-xl bg-cream px-4 py-3">Licensed physician in New Jersey; all visits by live video</li>
            <li class="rounded-xl bg-cream px-4 py-3">Former residency program director who taught physicians training in women's health</li>
            <li class="rounded-xl bg-cream px-4 py-3">{REVIEWS.google.rating} stars across {REVIEWS.google.count} Google reviews</li>
          </ul>
          <p class="mt-auto pt-6 text-sm text-ink/60">
            Video visits with Dr. Copur are usually available within the week.
            <a href={PORTAL_URL} class="font-semibold text-pine-900 underline underline-offset-4 hover:text-apricot-700">Schedule a video visit</a>
          </p>
        </article>

        <article class="card flex flex-col !p-10">
          <div class="flex items-center gap-5">
            <Image src={nurefsan} alt={`${DOCTOR2.name}, certified nurse midwife`} width={160} height={160} class="h-20 w-20 shrink-0 rounded-3xl object-cover object-top shadow-md" data-portrait="nurefsan" />
            <div>
              <h3 class="font-display text-2xl font-medium text-pine-900">{DOCTOR2.name}</h3>
              <p class="mt-1 text-sm font-medium text-apricot-700">Certified Nurse Midwife (not a physician)</p>
              <span class="mt-2 inline-block rounded-full bg-pine-100 px-3 py-1 text-xs font-semibold text-pine-800">Joining SheWellRX soon</span>
            </div>
          </div>
          <p class="mt-6 leading-relaxed text-ink/70">{DOCTOR2.bio}</p>
          <p class="eyebrow mt-6">What she will help with</p>
          <ul class="mt-3 grid gap-2 text-sm text-ink/80">
            {DOCTOR2.focus.map((item) => (
              <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-apricot-400" aria-hidden="true"></span>{item}</li>
            ))}
          </ul>
          <ul class="mt-6 grid gap-2 text-sm text-ink/80">
            <li class="rounded-xl bg-cream px-4 py-3">{DOCTOR2.education} (a nursing doctorate, not a medical degree)</li>
            <li class="rounded-xl bg-cream px-4 py-3">Certified nurse midwife licensed in New Jersey</li>
            <li class="rounded-xl bg-cream px-4 py-3">Visits in English, with intermediate Spanish</li>
            <li class="rounded-xl bg-cream px-4 py-3">Affiliated with {DOCTOR2.affiliation}</li>
          </ul>
          <p class="mt-auto pt-6 text-sm text-ink/60">
            Visits with Nurefsan open once she is set up in the patient portal;
            until then, every visit is with Dr. Copur.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">Patient reviews</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">
          What patients say, on every platform.
        </h2>
        <p class="mt-4 leading-relaxed text-ink/70">
          These ratings are published on independent review platforms. Each
          one links to its source, so you can read the reviews for yourself.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          ratings.map((r) => (
            <a
              href={r.url}
              rel="noopener"
              target="_blank"
              class="rounded-3xl border border-pine-900/10 bg-white p-6 transition-shadow hover:shadow-lg"
            >
              <p class="text-sm font-semibold text-ink/60">{r.platform}</p>
              <p
                class="mt-2 font-display text-4xl text-pine-900"
                data-google-rating={r.platform === "Google" ? "" : undefined}
              >
                {r.rating}
              </p>
              <div class="mt-2">
                <Stars rating={r.rating} />
              </div>
              <p class="mt-2 text-xs text-ink/50">
                <span data-google-count={r.platform === "Google" ? "" : undefined}>{r.count}</span> reviews
              </p>
            </a>
          ))
        }
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          REVIEWS.quotes.slice(0, 2).map((r) => (
            <figure class="rounded-3xl border border-pine-900/10 bg-white p-8">
              <Stars rating={5} />
              <blockquote class="mt-4 leading-relaxed text-ink/80">"{r.text}"</blockquote>
              <figcaption class="mt-4 flex items-center justify-between text-sm">
                <span class="font-semibold text-pine-900">{r.name}</span>
                <span class="text-ink/50">Verified Google review · {r.when}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-6 text-xs text-ink/50">
        Ratings and reviews retrieved from each platform's public listing as of {REVIEWS.google.asOf}.
      </p>
    </div>
  </section>

  <section class="bg-pine-800 text-cream">
    <div class="section text-center">
      <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
        Your first visit can be scheduled today.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-cream/70">
        Choose a time, and talk through what you are experiencing with a
        board certified ObGyn, usually within the week.
      </p>
      <a href={PORTAL_URL} class="btn-accent mt-8 !px-8 !py-4 !text-base">Schedule a video visit</a>
    </div>
  </section>
</Layout>
