---
import Layout from "../layouts/Layout.astro";

const steps = [
  {
    n: "01",
    title: "Complete your intake",
    body: "Answer a short set of health questions online — about five minutes. Your intake gives your clinician a full picture before you ever meet, so your visit time is spent on you, not paperwork.",
  },
  {
    n: "02",
    title: "Meet your clinician",
    body: "Connect by video or secure message with a licensed clinician. They review your history, answer your questions, and — when clinically appropriate — order labs to fill in the picture.",
  },
  {
    n: "03",
    title: "Get your plan",
    body: "You'll leave your visit with a written plan you can actually follow. If treatment is appropriate, prescriptions are sent to your door or your local pharmacy.",
  },
  {
    n: "04",
    title: "Stay supported",
    body: "Care doesn't end at checkout. Message your care team with questions, complete scheduled check-ins, and adjust your plan as your needs change.",
  },
];

const expectations = [
  {
    title: "Honest recommendations",
    body: "If treatment isn't right for you, your clinician will say so — and point you to a better option, including in-person care.",
  },
  {
    title: "Pricing before you commit",
    body: "You'll always see the full cost of a program up front. No surprise bills after the fact.",
  },
  {
    title: "Your data stays yours",
    body: "Your health information is shared only with the care team treating you, and deliveries arrive in discreet packaging.",
  },
];
---

<Layout
  title="How it works — EfhsanRX"
  description="From a five-minute intake to ongoing care: how EfhsanRX virtual visits, treatment plans, and follow-ups work."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Care in four steps. Support the whole way.
      </h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <ol class="grid gap-6 md:grid-cols-2">
        {
          steps.map((s) => (
            <li class="rounded-3xl border border-pine-900/10 bg-cream p-8 sm:p-10">
              <p class="font-display text-3xl text-apricot-500">{s.n}</p>
              <h2 class="mt-4 font-display text-2xl font-medium text-pine-900">{s.title}</h2>
              <p class="mt-3 leading-relaxed text-ink/70">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">What to expect</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Our promises to you.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          expectations.map((e) => (
            <div class="card">
              <h3 class="font-display text-xl font-medium text-pine-900">{e.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-pine-800 text-cream">
    <div class="section text-center">
      <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
        Ready when you are.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-cream/70">
        Book your first visit and be talking with a clinician this week.
      </p>
      <a href="/book" class="btn-accent mt-8">Book a visit</a>
    </div>
  </section>
</Layout>
