---
import Layout from "../layouts/Layout.astro";

const steps = [
  {
    n: "01",
    title: "Tell us what is going on",
    body: "Two minutes on this site: your concern, what you want from the visit, and a short safety check. Nothing you answer is stored or sent anywhere. Then you see the full price, pick a time, and pay securely in our patient portal.",
  },
  {
    n: "02",
    title: "Tell your story once",
    body: "Right after booking, your secure intake questionnaire and consent forms arrive in the patient portal. Your clinician reads every answer before you meet, so the visit is spent on you, not on paperwork.",
  },
  {
    n: "03",
    title: "Talk it through on video",
    body: "A real conversation with a clinician who has already read your answers. Questions welcomed, nothing rushed, labs ordered only when they will change the plan.",
  },
  {
    n: "04",
    title: "Leave with a plan",
    body: "A written plan you can reread, prescriptions sent to your local pharmacy when appropriate, and two weeks of included follow up messaging after every visit.",
  },
];

const expectations = [
  {
    title: "Honest recommendations",
    body: "If treatment is not right for you, your clinician will say so and point you to a better option, including in person care.",
  },
  {
    title: "Pricing before you commit",
    body: "You will always see the full cost before you book. No surprise bills after the fact.",
  },
  {
    title: "Your data stays yours",
    body: "Your health information lives only in our HIPAA compliant patient portal and is shared only with the team treating you. This website stores nothing about you.",
  },
];
---

<Layout
  title="How It Works | SheWellRX"
  description="How SheWellRX works: book a time, complete a short secure intake, meet your clinician on video, and leave with a written plan and two weeks of messaging."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Care in four steps. Support the whole way.
      </h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <ol class="grid gap-6 md:grid-cols-2">
        {
          steps.map((s) => (
            <li class="rounded-3xl border border-pine-900/10 bg-cream p-8 sm:p-10">
              <p class="font-display text-3xl text-apricot-500">{s.n}</p>
              <h2 class="mt-4 font-display text-2xl font-medium text-pine-900">{s.title}</h2>
              <p class="mt-3 leading-relaxed text-ink/70">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">What to expect</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Our promises to you.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          expectations.map((e) => (
            <div class="card">
              <h3 class="font-display text-xl font-medium text-pine-900">{e.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-pine-800 text-cream">
    <div class="section text-center">
      <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
        Ready when you are.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-cream/70">
        Book your first visit and be talking with a clinician this week.
      </p>
      <a href="/book" class="btn-accent mt-8">Book a visit</a>
    </div>
  </section>
</Layout>
