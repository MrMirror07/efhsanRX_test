---
import Layout from "../layouts/Layout.astro";

const steps = [
  {
    n: "01",
    title: "Tell us what you are experiencing",
    body: "Two minutes on this site: your concern, what you would like from the visit, and a short safety check. Your answers are not stored or sent anywhere. You then see the full price, choose a time, and pay securely in the patient portal.",
  },
  {
    n: "02",
    title: "Complete your intake once",
    body: "Right after booking, your secure intake questionnaire and consent forms are available in the patient portal. Your history is reviewed before the visit begins, so the thirty minutes are spent on you rather than on paperwork.",
  },
  {
    n: "03",
    title: "Meet your clinician on video",
    body: "A thirty minute video visit with a clinician who has already reviewed your history. Your questions are welcome, nothing is rushed, and laboratory tests are ordered only when the results would change your care plan.",
  },
  {
    n: "04",
    title: "Leave with a written care plan",
    body: "A written care plan you can return to, prescriptions sent to your pharmacy when clinically appropriate, and two weeks of secure messaging included after every visit.",
  },
];

const expectations = [
  {
    title: "Honest recommendations",
    body: "If a treatment is not appropriate for you, your clinician will say so and recommend a better option, including an in-person evaluation when one is needed.",
  },
  {
    title: "Pricing before you commit",
    body: "You will always see the full cost before you book. The visit fee is the only charge from SheWellRX, and a written Good Faith Estimate is provided with your confirmation.",
  },
  {
    title: "Your information stays private",
    body: "Your health information is kept only in our HIPAA compliant patient portal and is shared only with the team caring for you. This website stores nothing about you.",
  },
];
---

<Layout
  title="How It Works | SheWellRX"
  description="How SheWellRX works: choose a time, complete a secure intake, meet your clinician on video, and leave with a written care plan and two weeks of messaging."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Your care in four steps, with support throughout.
      </h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <ol class="grid gap-6 md:grid-cols-2">
        {
          steps.map((s) => (
            <li class="rounded-3xl border border-pine-900/10 bg-cream p-8 sm:p-10">
              <p class="font-display text-3xl text-apricot-500">{s.n}</p>
              <h2 class="mt-4 font-display text-2xl font-medium text-pine-900">{s.title}</h2>
              <p class="mt-3 leading-relaxed text-ink/70">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">What to expect</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">What you can expect from us.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          expectations.map((e) => (
            <div class="card">
              <h3 class="font-display text-xl font-medium text-pine-900">{e.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-pine-800 text-cream">
    <div class="section text-center">
      <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
        Begin when you are ready.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-cream/70">
        Schedule your first video visit and meet with a clinician from home.
      </p>
      <a href="/book" class="btn-accent mt-8">Schedule a video visit</a>
    </div>
  </section>
</Layout>
