---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found | SheWellRX">
  <section class="section text-center">
    <p class="eyebrow">404</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">
      That page seems to have wandered off.
    </h1>
    <p class="mx-auto mt-4 max-w-md text-ink/70">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</Layout>
