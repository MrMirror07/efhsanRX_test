---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found | SheWellRX" noindex>
  <section class="section text-center">
    <p class="eyebrow">404</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">
      This page could not be found.
    </h1>
    <p class="mx-auto mt-4 max-w-md text-ink/70">
      The page you are looking for may have moved or is no longer available.
    </p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</Layout>
