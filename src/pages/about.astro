---
import Layout from "../layouts/Layout.astro";

const values = [
  {
    title: "Clinical honesty",
    body: "We recommend treatment when it is right and say so when it is not. Trust is the product; everything else is downstream of it.",
  },
  {
    title: "Continuity over transactions",
    body: "A prescription without follow up is a transaction, not care. Every visit includes two weeks of messaging with a team that knows your history.",
  },
  {
    title: "Respect for your time",
    body: "Short intakes, visits from home, answers in plain language. We build around your life, not our office hours.",
  },
  {
    title: "Privacy by default",
    body: "Your records live in a secure patient portal and are shared only with the people treating you. Nothing you answer on this website is stored or sent anywhere; your medical history is collected only inside the portal after you book.",
  },
];
---

<Layout
  title="About Us | SheWellRX"
  description="SheWellRX is a virtual care clinic on a mission to make expert, continuous healthcare accessible from anywhere."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">About us</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Healthcare kept getting harder to reach. So we brought it to you.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        SheWellRX started with a simple observation: the hardest part of getting
        better is often just getting seen. Long waits, crowded waiting rooms,
        and five rushed minutes with a stranger, for care that could have
        started today.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink/70">
        We are a small practice built around a board certified ObGyn with more
        than 35 years of experience, with a certified nurse midwife joining
        soon, bringing that care to your living room: a full history, a real
        conversation, a plan you can follow, and a clinician who is still there
        next month.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">What we believe</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Our values.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          values.map((v) => (
            <div class="rounded-3xl border border-pine-900/10 bg-cream p-8 sm:p-10">
              <h3 class="font-display text-2xl font-medium text-pine-900">{v.title}</h3>
              <p class="mt-3 leading-relaxed text-ink/70">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="card !bg-pine-800 !p-12 text-center text-cream sm:!p-16">
        <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
          Meet us where you are.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-cream/70">
          Your first visit takes minutes to book and happens wherever you're
          comfortable.
        </p>
        <a href="/book" class="btn-accent mt-8">Start your visit</a>
      </div>
    </div>
  </section>
</Layout>
