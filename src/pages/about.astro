---
import Layout from "../layouts/Layout.astro";
import { DOCTOR2 } from "../config";

const values = [
  {
    title: "Clinical honesty",
    body: "Treatment is recommended when it is clinically appropriate, and you are told plainly when it is not. Every recommendation is explained in terms you can weigh for yourself.",
  },
  {
    title: "Continuity of care",
    body: "Your care continues after the visit ends. Every visit includes two weeks of secure messaging with a team that knows your history, and each follow-up visit is with a clinician who already has your full record.",
  },
  {
    title: "Respect for your time",
    body: "A short intake form, a visit from home, and answers in plain language, so the time you give to your care is spent on you.",
  },
  {
    title: "Privacy by default",
    body: "Your records are kept in a secure patient portal and shared only with the clinicians treating you. Nothing you answer on this website is stored or sent anywhere; your medical history is collected only inside the portal, after you schedule a visit.",
  },
];
---

<Layout
  title="About Us | SheWellRX"
  description="SheWellRX is a self-pay women's telehealth practice in New Jersey: two clinicians, video visits from home, a written care plan, and care that continues."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">About us</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Women's health care that is easier to reach, and stays with you.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        SheWellRX began with a simple observation: the hardest part of getting
        well is often getting seen. A long wait for an appointment, a crowded
        waiting room, and a brief visit with an unfamiliar clinician can delay
        care that could begin this week.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink/70">
        We are a small team of two clinicians: a board certified ObGyn with
        more than thirty five years of experience, and {DOCTOR2.name}, a
        certified nurse midwife who joins the practice soon. Your visit takes
        place by video from home: a full review of your history, an unhurried
        conversation, a written care plan you can follow, and a clinician who
        is still there at your next visit.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink/70">
        Today every visit is with the physician. When visits with the nurse
        midwife open, you will be told who your visit is with at the time you
        schedule, and you may always request the physician.
        <a href="/doctor" class="font-semibold text-pine-900 underline underline-offset-4">Meet your clinicians</a>
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <div class="max-w-2xl">
        <p class="eyebrow">Our approach</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">What you can expect from every visit.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          values.map((v) => (
            <div class="rounded-3xl border border-pine-900/10 bg-cream p-8 sm:p-10">
              <h3 class="font-display text-2xl font-medium text-pine-900">{v.title}</h3>
              <p class="mt-3 leading-relaxed text-ink/70">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="section">
      <div class="card !bg-pine-800 !p-12 text-center text-cream sm:!p-16">
        <h2 class="display mx-auto max-w-2xl text-3xl !text-cream sm:text-4xl">
          Your first visit begins wherever you are.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-cream/70">
          Scheduling takes a few minutes, and your visit takes place wherever
          in New Jersey you are comfortable.
        </p>
        <a href="/book" class="btn-accent mt-8">Start your visit</a>
      </div>
    </div>
  </section>
</Layout>
