---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { CONDITIONS, NJ_COUNTIES, NJ_CITIES } from "../data/conditions";
import { SITE, DOCTOR, PRICING, REVIEWS, PORTAL_URL } from "../config";
import drCopur from "../assets/dr-copur.jpg";
import visitWindow from "../assets/visit-window.jpg";

const title = "How Online Gynecology Works in New Jersey | SheWellRX";
const description =
  "What an online gynecologist can and cannot do in New Jersey, the state's telehealth rules in plain language, and how a $249 video visit works.";

const faqs = [
  {
    q: "Is an online gynecologist visit legal in New Jersey?",
    a: "Yes. New Jersey law allows physicians licensed in the state to diagnose, treat, and prescribe through live video telehealth, held to the same standard of care as an in person visit. The patient must be physically located in New Jersey during the visit, and a relationship must be established through a real encounter, not a questionnaire alone.",
  },
  {
    q: "What can a gynecologist do over video?",
    a: "Take a full history, review symptoms and records, diagnose common conditions such as perimenopause, menopause, PCOS, and genitourinary symptoms, prescribe hormone therapy and contraception, order labs and imaging near your home, and manage treatment over time. What a camera cannot do is a pelvic exam, a Pap test, an ultrasound, a biopsy, or a procedure; those are referred to a local office and your records follow.",
  },
  {
    q: "Do I need insurance?",
    a: "No. SheWellRX is self pay: $249 for a thirty minute initial visit and $149 for follow ups, paid once at booking. HSA and FSA cards are accepted, and you can request an itemized superbill for out of network benefits.",
  },
  {
    q: "How quickly can I be seen?",
    a: "Online booking shows real openings, usually within the week, Monday through Friday during business hours Eastern time. You pick the time, pay, and receive your video link and intake by email.",
  },
  {
    q: "Which parts of New Jersey do you serve?",
    a: "All of them. Because visits are by video, patients from Bergen County to Cape May County book the same way. You simply need to be in New Jersey at the time of your visit.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      url: `${SITE.url}/online-gynecologist-new-jersey/`,
      name: title,
      description,
      lastReviewed: "2026-09-02",
      reviewedBy: { "@type": "Physician", name: DOCTOR.name, url: `${SITE.url}/doctor` },
      about: { "@type": "MedicalSpecialty", name: "Gynecology" },
      audience: { "@type": "MedicalAudience", audienceType: "Patient", geographicArea: { "@type": "State", name: "New Jersey" } },
    },
    { "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  ],
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[36rem] bg-[radial-gradient(55%_50%_at_85%_0%,rgba(60,111,127,0.14),transparent_70%)]" aria-hidden="true"></div>
    <div class="section relative grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <Breadcrumbs items={[{ name: "Online gynecologist in New Jersey", href: "/online-gynecologist-new-jersey/" }]} />
        <p class="eyebrow mt-8">Telehealth · New Jersey</p>
        <h1 class="display mt-4 text-4xl leading-[1.05] sm:text-5xl lg:text-[3.5rem]">An online gynecologist for every woman in New Jersey</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">
          A thirty minute video visit with {DOCTOR.name}, board certified in obstetrics and gynecology and in practice in northern New Jersey since 2002. Menopause, hormone therapy, birth control, PCOS and period problems, and sexual health, treated from your living room with a written plan and two weeks of follow up messaging. One flat fee, no insurance needed.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={PORTAL_URL} class="btn-accent group !px-7 !py-4 !text-base">Start your visit · ${PRICING.initial.price}</a>
          <a href="/doctor" class="btn-secondary !py-4 !text-base">Meet Dr. Copur</a>
        </div>
      </div>
      <figure class="overflow-hidden rounded-[2rem] lg:col-span-5" data-reveal>
        <Image src={visitWindow} alt="A woman in New Jersey on a video visit with her gynecologist" class="aspect-[4/3] w-full object-cover" widths={[640, 960]} sizes="(min-width: 1024px) 40vw, 92vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">What we treat by video</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Care that fits on a screen, <em>honestly</em> described</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          CONDITIONS.map((c) => (
            <a href={`/conditions/${c.slug}/`} class="group card flex flex-col !p-7 transition-all hover:-translate-y-1 hover:shadow-[0_30px_60px_-24px_rgba(15,39,51,0.3)]" data-spotlight>
              <h3 class="font-display text-2xl font-medium text-pine-900">{c.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">{c.description.split(". ")[0]}.</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-apricot-700">Read more <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg></span>
            </a>
          ))
        }
        <a href="/services#labs" class="group card flex flex-col !p-7 transition-all hover:-translate-y-1" data-spotlight>
          <h3 class="font-display text-2xl font-medium text-pine-900">Labs and screenings</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">Hormone panels, thyroid testing, and preventive screening ordered when they change the plan, at a lab near your home.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-apricot-700">Read more <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg></span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-sand/60">
    <div class="section grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">How New Jersey telehealth works</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">The rules, in plain language</h2>
        <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-ink/75">
          <p><strong class="text-pine-900">Your location decides.</strong> Medical licensing follows the patient. Dr. Copur is licensed in New Jersey, so you must be in New Jersey during your visit, whether that is home, work, or a parked car with the door locked.</p>
          <p><strong class="text-pine-900">Video, not a questionnaire.</strong> New Jersey requires a live encounter before any prescription. Your intake prepares the visit; the decision happens face to face on video.</p>
          <p><strong class="text-pine-900">The same standard of care.</strong> Telehealth is held to the in person standard. When a concern needs an exam, an ultrasound, a biopsy, or a procedure, we say so and refer you locally, with your records.</p>
          <p><strong class="text-pine-900">Identity and privacy.</strong> You verify who you are before the first visit, your health information lives only in our HIPAA compliant portal, and visits are never recorded.</p>
        </div>
      </div>
      <div class="lg:col-span-5" data-reveal>
        <div class="card !p-8">
          <div class="flex items-center gap-4">
            <Image src={drCopur} alt={DOCTOR.name} width={128} height={128} class="h-16 w-16 rounded-2xl object-cover object-top" />
            <div>
              <p class="font-semibold text-pine-900">{DOCTOR.name}, FACOG</p>
              <p class="text-xs text-ink/60">Board certified ObGyn (ABOG) since {DOCTOR.boardCertifiedSince}</p>
            </div>
          </div>
          <ul class="mt-6 space-y-2 text-sm text-ink/75">
            <li>Licensed physician in New Jersey</li>
            <li>In private practice in northern New Jersey since {DOCTOR.practicingSince}</li>
            <li>{REVIEWS.google.rating} stars across {REVIEWS.google.count} Google reviews</li>
            <li>Member, American College of Obstetricians and Gynecologists</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="section">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Everywhere in the state</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">From Bergen County to Cape May, the same visit</h2>
        <p class="mt-4 text-ink/70">There is no office to drive to. Women in every New Jersey county book the same thirty minute video visit, including:</p>
      </div>
      <ul class="mt-8 flex flex-wrap gap-2" data-reveal-stagger>
        {NJ_COUNTIES.map((c) => <li class="rounded-full border border-pine-900/10 bg-cream px-3.5 py-1.5 text-sm text-pine-900">{c} County</li>)}
      </ul>
      <p class="mt-6 text-sm text-ink/60">Patients join from {NJ_CITIES.slice(0, 12).join(", ")}, and every town in between.</p>
    </div>
  </section>

  <section>
    <div class="section max-w-3xl" data-reveal>
      <p class="eyebrow">Questions</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl">Online gynecology in New Jersey, answered</h2>
      <div class="mt-8 divide-y divide-pine-900/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl font-medium text-pine-900">
                {f.q}
                <span class="faq-plus inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-pine-900/15 text-pine-700">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-10">
        <a href={PORTAL_URL} class="btn-accent !px-8 !py-4 !text-base">Start your visit</a>
      </div>
    </div>
  </section>
</Layout>
