---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    title: "Weight management",
    tagline: "Medical weight care, not a diet plan",
    points: [
      "Clinician-led evaluation of your metabolism, history, and goals",
      "Personalized treatment plans, adjusted at regular check-ins",
      "Nutrition and habit support between visits",
    ],
  },
  {
    title: "Hormonal health",
    tagline: "Answers for symptoms you've been told to live with",
    points: [
      "Structured evaluation of energy, sleep, mood, and cycle symptoms",
      "Lab orders when needed, reviewed with you in plain language",
      "Evidence-based treatment options and honest guidance",
    ],
  },
  {
    title: "Hair & skin",
    tagline: "Dermatology-informed care, delivered discreetly",
    points: [
      "Treatment plans for hair loss, acne, and skin health",
      "Photo-based follow-ups so progress is tracked, not guessed",
      "Discreet home delivery for prescribed treatments",
    ],
  },
  {
    title: "Sexual health",
    tagline: "Effective care without the awkward waiting room",
    points: [
      "Private consultations with licensed clinicians",
      "Proven treatment options when clinically appropriate",
      "Unmarked packaging and confidential records",
    ],
  },
  {
    title: "Everyday primary care",
    tagline: "The visit you'd put off, made easy",
    points: [
      "Same-week virtual visits for common conditions",
      "Prescription renewals and lab orders",
      "Referrals to in-person care when you need it",
    ],
  },
  {
    title: "Mental wellness",
    tagline: "Support that adapts as you do",
    points: [
      "Care plans for stress, sleep, and mood",
      "Structured check-ins with your care team",
      "Escalation to specialist care when appropriate",
    ],
  },
];
---

<Layout
  title="What we treat — EfhsanRX"
  description="Explore EfhsanRX virtual care programs: weight management, hormonal health, hair & skin, sexual health, everyday primary care, and mental wellness."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">What we treat</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Real programs, for real life.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        Every program is led by licensed clinicians and built around one idea:
        care should continue after the appointment ends.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="section grid gap-8 md:grid-cols-2">
      {
        services.map((s) => (
          <article class="rounded-3xl border border-pine-900/10 bg-cream p-8 sm:p-10">
            <h2 class="font-display text-2xl font-medium text-pine-900">{s.title}</h2>
            <p class="mt-1 text-sm font-medium text-apricot-600">{s.tagline}</p>
            <ul class="mt-6 space-y-3">
              {s.points.map((p) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-pine-500"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
            <a href="/book" class="btn-secondary mt-8">Book a visit</a>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section text-center">
      <h2 class="display mx-auto max-w-2xl text-3xl sm:text-4xl">
        Not sure which program fits?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/70">
        Start with a general visit. Your clinician will help you figure out the
        right next step — even if that step isn't with us.
      </p>
      <a href="/book" class="btn-accent mt-8">Start with a visit</a>
    </div>
  </section>
</Layout>
