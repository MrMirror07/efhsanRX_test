---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { PORTAL_URL, TREATMENTS } from "../config";
import calmTea from "../assets/calm-tea.png";
import tileBirthControl from "../assets/tile-birth-control.png";
import tileMenopause from "../assets/tile-menopause.png";
import tileHormone from "../assets/tile-hormone.png";
import tileIntimacy from "../assets/tile-intimacy.png";
import tileLabs from "../assets/tile-labs.png";

const tileImages = {
  "birth-control": tileBirthControl,
  menopause: tileMenopause,
  "hormone-therapy": tileHormone,
  "sexual-health": tileIntimacy,
  periods: calmTea,
  labs: tileLabs,
} as const;

/** Deeper detail per treatment area, keyed by the slugs in TREATMENTS. */
const detail: Record<
  (typeof TREATMENTS)[number]["slug"],
  { intro: string; prescribed: string[]; visit: string[] }
> = {
  "birth-control": {
    intro:
      "There is no single best contraceptive, only the one that fits your body, your history, and what you want the next few years to look like. Your visit is a real conversation about the options, not a form with checkboxes.",
    prescribed: [
      "Combined estrogen and progestin pills",
      "Progestin only pills for those who should avoid estrogen",
      "The patch and the vaginal ring",
      "Emergency contraception guidance",
    ],
    visit: [
      "A method matched to your health history and preferences",
      "A prescription sent to your pharmacy the same day when appropriate",
      "A clear plan for what to expect in the first months",
    ],
  },
  menopause: {
    intro:
      "Hot flashes, night sweats, sleep that falls apart at 3 a.m. Perimenopause and menopause are not something to white knuckle through. Treatment exists, it works, and a specialist can tell you which kind is safe for you.",
    prescribed: [
      "Menopausal hormone therapy when your history allows it",
      "Non hormonal options for vasomotor symptoms",
      "Support for sleep and mood alongside the hormonal picture",
    ],
    visit: [
      "A full review of symptoms, history, and contraindications",
      "An honest conversation about benefits and risks, in plain language",
      "A written plan you can share with any other doctor you see",
    ],
  },
  "hormone-therapy": {
    intro:
      "Hormone therapy has been argued about in headlines for twenty years. What you need is not a headline, it is a doctor who knows the evidence and your chart. Started at the right dose for the right patient, it can change daily life.",
    prescribed: [
      "Estradiol patches, gels, and tablets",
      "Micronized progesterone for uterine protection",
      "Low dose regimens designed to start gently",
    ],
    visit: [
      "Screening for the conditions that make hormones unsafe",
      "A dosing plan reviewed and adjusted at follow ups",
      "Lab work ordered only when it will change the decision",
    ],
  },
  "sexual-health": {
    intro:
      "Dryness, pain with intimacy, desire that faded and never came back. These are medical issues with medical answers, and they deserve the same seriousness as any other diagnosis. No awkward waiting room required.",
    prescribed: [
      "Vaginal estrogen creams and tablets",
      "Moisturizers and comfort care that actually help",
      "Evaluation of medications that may be lowering desire",
    ],
    visit: [
      "A private, judgment free conversation with your clinician",
      "Treatment started the same week when appropriate",
      "Follow up messaging to adjust what is not working",
    ],
  },
  periods: {
    intro:
      "A period that floods through protection, cramps that cancel plans, cycles that vanish for months. Your cycle is a vital sign, and when it changes, something is being said. We find out what.",
    prescribed: [
      "Cycle regulation with hormonal options",
      "Treatment for heavy bleeding when appropriate",
      "Care plans for PCOS and irregular cycles",
    ],
    visit: [
      "A structured evaluation of your bleeding pattern",
      "Lab and imaging orders when the story calls for them",
      "A plain answer about what needs in person care",
    ],
  },
  labs: {
    intro:
      "Lab work should answer a question, not pad a bill. When your plan needs data, we order exactly what will change the decision and send you to a lab near your home, then explain every line of the result.",
    prescribed: [
      "Hormone panels timed to your cycle",
      "Thyroid testing when symptoms overlap",
      "Preventive screenings appropriate to your age",
    ],
    visit: [
      "Orders sent to a national lab close to you",
      "Results reviewed together, in words you can use",
      "No test ordered without telling you why first",
    ],
  },
};
---

<Layout
  title="What We Treat — Birth Control, Menopause, Hormones | EfhsanRX"
  description="EfhsanRX treats birth control needs, menopause and perimenopause, hormone therapy, sexual health, period problems, and lab work, all by video with prescriptions sent to your pharmacy."
>
  <section class="section">
    <div class="max-w-2xl">
      <p class="eyebrow">What we treat</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">
        Real symptoms. Real medicine. Real answers.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        Every visit is a conversation with a clinician who specializes in
        women's health. When medication is right for you, the prescription
        goes to your pharmacy before the day ends.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="section space-y-8">
      {
        TREATMENTS.map((t, i) => (
          <article
            id={t.slug}
            class="grid scroll-mt-24 items-center gap-8 overflow-hidden rounded-[2rem] border border-pine-900/10 bg-cream lg:grid-cols-2"
          >
            <figure class:list={["h-full min-h-64", i % 2 === 1 && "lg:order-last"]}>
              <Image
                src={tileImages[t.slug]}
                alt={`${t.title} at EfhsanRX`}
                class="h-full w-full object-cover"
                widths={[480, 768, 1080]}
                sizes="(min-width: 1024px) 45vw, 90vw"
              />
            </figure>
            <div class="p-8 sm:p-10 lg:py-12">
              <h2 class="font-display text-2xl font-medium text-pine-900 sm:text-3xl">{t.title}</h2>
              <p class="mt-4 leading-relaxed text-ink/70">{detail[t.slug].intro}</p>
              <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.15em] text-pine-500">
                What can be prescribed
              </h3>
              <ul class="mt-3 space-y-2">
                {detail[t.slug].prescribed.map((p) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                    </svg>
                    {p}
                  </li>
                ))}
              </ul>
              <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.15em] text-pine-500">
                What your visit includes
              </h3>
              <ul class="mt-3 space-y-2">
                {detail[t.slug].visit.map((p) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-pine-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                    </svg>
                    {p}
                  </li>
                ))}
              </ul>
              <a href={PORTAL_URL} class="btn-primary group mt-8">
                Book this visit
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
      <p class="text-xs leading-relaxed text-ink/50">
        Medication names and classes above are examples of what can be
        prescribed when clinically appropriate. Nothing on this page is a
        guarantee of prescription. Every treatment decision is made by your
        clinician, with you, during your visit.
      </p>
    </div>
  </section>

  <section>
    <div class="section text-center">
      <h2 class="display mx-auto max-w-2xl text-3xl sm:text-4xl">
        Not sure where you fit?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/70">
        Start with a visit. Your clinician will help you find the right next
        step, even if that step is not with us.
      </p>
      <a href={PORTAL_URL} class="btn-accent mt-8">Start with a visit</a>
    </div>
  </section>
</Layout>
